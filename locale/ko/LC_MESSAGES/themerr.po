msgstr "Todo: 사용자가 초기 설정을 완료했는지 여부를 나타냅니다."

#: src/common/config.py:108
msgid "General"
msgstr "일반"

#: src/common/config.py:109
msgid "General settings."
msgstr "일반 설정."

#: src/common/config.py:113
msgid "Locale"
msgstr "지역 설정"

#: src/common/config.py:114
