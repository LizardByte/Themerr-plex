msgid "Update database cache interval"
msgstr "Uppdatera databasens cacheintervall"

#: src/common/config.py:363
msgid "Interval for database cache update task, in minutes (min: 15)."
msgstr "Intervall för uppdateringsuppgift för databascachen, i minuter (min: 15)."

