msgstr "https://support.plex.tv/articles/202915258-where-is-the-plex-media-server-data-locctory-located/"

#: src/common/config.py:327
msgid "Themerr"
msgstr "Tajemnica"

#: src/common/config.py:328
msgid "Themerr settings."
msgstr "Ustawienia Temerra."

#: src/common/config.py:332
msgid "Themerr Enabled"
msgstr "Themerr włączony"

#: src/common/config.py:333
msgid "When enabled, Themerr will attempt to update themes."
msgstr "Po włączeniu Themerr spróbuje zaktualizować motywy."

#: src/common/config.py:339
msgid "Add themes to collections."
msgstr "Dodaj motywy do kolekcji."

#: src/common/config.py:345
msgid "Add themes to movies using the Plex Movie agent."
msgstr "Dodaj motywy do filmów za pomocą agenta Plex Movie."

#: src/common/config.py:351
msgid "Add themes to series using the Plex Series agent."
msgstr "Dodaj motywy do serii za pomocą agenta Plex Series."

#: src/common/config.py:356
msgid "Overwrite Plex themes"
msgstr "Nadpisz motywy Plex"

#: src/common/config.py:357
msgid "When enabled, Themerr will overwrite themes provided by Plex."
msgstr "Po włączeniu Themerr nadpisze motywy dostarczone przez Plex."

#: src/common/config.py:362
msgid "Prefer MP4A AAC Codec"
msgstr "Preferuj kod MP4A AAC"

#: src/common/config.py:363
msgid "This can improve theme compatibility with Apple devices."
msgstr "Może to poprawić kompatybilność motywów z urządzeniami Apple'a."

#: src/common/config.py:368
msgid "Remove unused themes"
msgstr "Usuń nieużywane motywy"

#: src/common/config.py:369
msgid "Frees up space in your Plex metadata directory. This option requires that the \"Plex data directory\" path is set"
msgstr "Zwolnia miejsce w katalogu metadanych Plex. Ta opcja wymaga ustawienia ścieżki \"Plex data Directory\""

#: src/common/config.py:375
msgid "Remove unused art"
msgstr "Usuń nieużywaną sztukę"

#: src/common/config.py:376 src/common/config.py:384
msgid "Applies to collection. Frees up space in your Plex metadata directory. This option requires that the \"Plex data directory\" path is set"
msgstr "Stosuje się do kolekcji. Zwolnij miejsce w katalogu metadanych Plex. Ta opcja wymaga ustawienia ścieżki \"Plex data directory\""

#: src/common/config.py:383
msgid "Remove unused posters"
msgstr "Usuń niewykorzystane plakaty"

#: src/common/config.py:391
msgid "Collection metadata"
msgstr "Metadane kolekcji"

#: src/common/config.py:392
msgid "Update collection metadata (poster, art, and summary) during scheduled update."
msgstr "Aktualizuj metadane kolekcji (plakat, sztuka i podsumowanie) podczas planowanej aktualizacji."

#: src/common/config.py:397
msgid "Ignore locked fields."
msgstr "Ignoruj zablokowane pola."

#: src/common/config.py:398
msgid "If you used Themerr v2024.813.13709 or lower, you may need to enable this to update items."
msgstr "Jeśli używałeś Themerr v2024.813.13709 lub niższego, może być konieczne włączenie tej opcji aby zaktualizować pozycje."

#: src/common/config.py:404
msgid "Ignored library IDs"
msgstr "Ignorowane ID biblioteki"

#: src/common/config.py:405
msgid "Comma-separated library IDs to exclude from scheduled updates. IDs appear on Home."
msgstr "ID biblioteki oddzielonej przecinkami do wykluczenia z zaplanowanych aktualizacji. ID pojawiają się w domu."

#: src/common/config.py:411
msgid "Update themes interval"
msgstr "Aktualizuj interwał motywów"

#: src/common/config.py:412
msgid "Interval for automatic update task, in minutes (min: 15)."
msgstr "Interwał dla zadania automatycznej aktualizacji, w minutach (min: 15)."

#: src/common/config.py:419
msgid "Update database cache interval"
msgstr "Aktualizuj interwał pamięci podręcznej bazy danych"

#: src/common/config.py:420
msgid "Interval for database cache update task, in minutes (min: 15)."
msgstr "Interwał dla zadania aktualizacji pamięci podręcznej bazy danych, w minutach (min: 15)."

#: src/common/config.py:427
msgid "PlexAPI timeout"
msgstr "Limit czasu PlexAPI"

#: src/common/config.py:428
msgid "Increase this slightly if you experience timeouts when adding themes. (min: 1)"
msgstr "Zwiększ to nieznacznie jeśli masz limit czasu podczas dodawania motywów. (min: 1)"

#: src/common/config.py:435
msgid "Theme upload retries"
msgstr "Ponów próby przesyłania motywu"

#: src/common/config.py:436
msgid "If uploading themes fail, retry this many times. (min: 0)"
msgstr "Jeśli przesłanie motywów nie powiedzie się, spróbuj ponownie to wiele razy. (min: 0)"

#: src/common/config.py:443
msgid "Multiprocessing thread count"
msgstr "Liczba wątków wieloprzetwarzanych"

#: src/common/config.py:444
msgid "The number of threads to use when adding themes. Restart required. (min: 1)"
msgstr "Liczba wątków do użycia podczas dodawania motywów. Wymagane ponowne uruchomienie (min: 1)"

#: src/common/config.py:452
msgid "YouTube Cookies"
msgstr "Pliki cookie YouTube"

#: src/common/config.py:454
msgid "Optional: export youtube.com cookies with Get cookies.txt LOCALLY using its JSON format, then paste the entire JSON array here and save. Saved cookies are encrypted and masked. Select the eye icon to reveal them. Leave this blank to keep them, or select Clear saved cookies to remove them."
msgstr "Opcjonalnie: eksport ciasteczek youtube.com za pomocą Pobierz ciasteczka.txt LOCALLY przy użyciu formatu JSON, a następnie wklej tutaj całą tablicę JSON i zapisz. Zapisane ciasteczka są zaszyfrowane i zamaskowane. Wybierz ikonę oczu, aby je pokazać. Pozostaw to pole puste, aby je zachować lub wybierz Wyczyść zapisane ciasteczka aby je usunąć."

#: src/common/config.py:461
msgid "Cookie export instructions"
msgstr "Instrukcje eksportu plików cookie"

