#: web/templates/api_docs.html:6
msgid "Explore the API using your signed-in session."
msgstr "Przeglądaj API przy użyciu zalogowanej sesji."

#: web/templates/auth.html:7
msgid "THE SOUND OF YOUR LIBRARY"
msgstr "ŹRÓDŁO TWOJ LIBRARII"

#: web/templates/auth.html:8
msgid "Every story"
msgstr "Każda opowieść"

#: web/templates/auth.html:8
msgid "has a soundtrack."
msgstr "posiada ścieżkę dźwiękową."

#: web/templates/auth.html:9
msgid "Bring your Plex libraries to life. One calm workspace for your servers, your themes, and everything in between."
msgstr "Przynieś swoje biblioteki Plex do życia. Jeden spokojny obszar roboczy dla serwerów, twoich motywów i wszystkiego między nimi."

#: web/templates/auth.html:18
msgid "Your workspace, secured."
msgstr "Twój obszar roboczy, zabezpieczony."

#: web/templates/auth.html:19
msgid "Open the one-time setup link printed in the application console to create your admin account."
msgstr "Otwórz jednorazowy link konfiguracyjny wydrukowany w konsoli aplikacji, aby utworzyć konto administratora."

#: web/templates/auth.html:20
msgid "The link is generated each time the application starts, until setup is complete."
msgstr "Link jest generowany za każdym razem, gdy aplikacja zaczyna się aż do zakończenia instalacji."

#: web/templates/auth.html:22
msgid "GET STARTED"
msgstr "ROZPOCZNIJ"

#: web/templates/auth.html:22
msgid "WELCOME BACK"
msgstr "BACK WELCOME"

