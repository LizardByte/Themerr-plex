msgstr "Ustawienia rejestrowania."

#: src/common/config.py:168
msgid "Log directory"
msgstr "Katalog logów"

#: src/common/config.py:170
msgid "The directory where to store the log files."
msgstr "Katalog przechowywania plików dziennika."

#: src/common/config.py:177
msgid "Debug logging"
msgstr "Rejestrowanie debugowania"

#: src/common/config.py:179
msgid "Enable debug logging."
msgstr "Włącz logowanie debugowania."

#: src/common/config.py:185
msgid "Network"
msgstr "Sieć"

#: src/common/config.py:186
msgid "Network settings."
msgstr "Ustawienia sieci."

#: src/common/config.py:190
msgid "HTTP host address"
msgstr "Adres hosta HTTP"

#: src/common/config.py:192
msgid "The HTTP address to bind to."
msgstr "Adres HTTP do powiązania."

#: src/common/config.py:201
msgid "HTTP port"
msgstr "Port HTTP"

#: src/common/config.py:203
msgid "Port to bind web server to. Note that ports below 1024 may require root."
msgstr "Port do powiązania serwera WWW. Zauważ, że porty poniżej 1024 mogą wymagać roota."

#: src/common/config.py:211
msgid "HTTP root"
msgstr "Główny HTTP"

#: src/common/config.py:213
msgid "Todo: The base URL of the web server. Used for reverse proxies."
msgstr "Todo: Podstawowy adres URL serwera WWW. Używany do proxy odwrotnych."

#: src/common/config.py:218
msgid "SSL"
msgstr "SSL"

#: src/common/config.py:220
msgid "Run the web server with HTTPS. Disabling this can be a security risk, do so at your own risk."
msgstr "Uruchom serwer internetowy za pomocą protokołu HTTPS. Wyłączenie tego może stanowić zagrożenie dla bezpieczeństwa, czyń to na własne ryzyko."

#: src/common/config.py:226
msgid "Updater"
msgstr "Aktualizator"

#: src/common/config.py:227
msgid "Updater settings."
msgstr "Ustawienia aktualizacji."

#: src/common/config.py:231
msgid "Auto update"
msgstr "Automatyczna aktualizacja"

#: src/common/config.py:239
msgid "Jellyfin"
msgstr "Jellyfin"

#: src/common/config.py:240
msgid "Jellyfin theme processing settings. Connections are managed on the Servers page."
msgstr "Ustawienia przetwarzania motywu Jellyfin. Połączenia są zarządzane na stronie serwerów."

#: src/common/config.py:243 src/common/config.py:344
msgid "Movie support"
msgstr "Wsparcie dla filmów"

#: src/common/config.py:244
msgid "Add themes to Jellyfin movies."
msgstr "Dodaj motywy do filmów Jellyfina."

#: src/common/config.py:247 src/common/config.py:350
msgid "Series support"
msgstr "Obsługa serii"

#: src/common/config.py:248
msgid "Add themes to Jellyfin series."
msgstr "Dodaj motywy do serii Jellyfin."

#: src/common/config.py:251 src/common/config.py:338 web/templates/home.html:31
msgid "Collections"
msgstr "Kolekcje"

#: src/common/config.py:252
msgid "Add themes inside Jellyfin’s collection directories. Media files can remain elsewhere."
msgstr "Dodaj motywy wewnątrz katalogów kolekcji Jellyfin. Pliki multimedialne mogą pozostać gdzie indziej."

#: src/common/config.py:255
msgid "Overwrite user themes"
msgstr "Nadpisz motywy użytkownika"

#: src/common/config.py:256
msgid "Replace existing theme files, including themes created by the older Themerr-jellyfin plugin."
msgstr "Zastąp istniejące pliki motywów, w tym motywy utworzone przez starszą wtyczkę Themerr-jellyfin."

#: src/common/config.py:260
msgid "Back up replaced user themes"
msgstr "Kopia zapasowa zastąpionych motywów użytkownika"

#: src/common/config.py:261
msgid "Keep existing user themes in a backup folder when replacing them. Disable to permanently remove replaced themes."
msgstr "Zachowaj istniejące motywy użytkownika w folderze kopii zapasowej podczas zastępowania ich. Wyłącz, aby trwale usunąć zastąpione motywy."

#: src/common/config.py:265
msgid "Import older Themerr-jellyfin ownership"
msgstr "Importuj starszą własność Themerr-jellyfin"

#: src/common/config.py:266
msgid "Recognize themes recorded in the older plugin’s database only when their SHA-256 still matches. Changed files stay protected. The old database is left untouched."
msgstr "Rozpoznaj motywy zapisane w bazie danych starszej wtyczki tylko wtedy, gdy ich SHA-256 nadal pasuje. Zmienione pliki pozostają chronione. Stara baza danych pozostaje niezmieniona."

#: src/common/config.py:270
msgid "Ignore locked metadata"
msgstr "Ignoruj zablokowane metadane"

#: src/common/config.py:271
msgid "Allow Jellyfin theme updates for items with locked metadata."
msgstr "Zezwalaj na aktualizacje motywu Jellyfin dla elementów z zablokowanymi metadanymi."

#: src/common/config.py:274
msgid "Update connector automatically"
msgstr "Automatycznie aktualizuj konektor"

#: src/common/config.py:275
msgid "Install the matching connector when Themerr starts or detects a version mismatch. Set the reachable Themerr address on the Servers page first."
msgstr "Zainstaluj pasujący konektor po uruchomieniu lub wykryciu niezgodności wersji. Ustaw najpierw osiągalny adres Themerr na stronie serwerów."

#: src/common/config.py:279
msgid "Restart Jellyfin automatically"
msgstr "Uruchom ponownie Jellyfin automatycznie"

#: src/common/config.py:280
msgid "Restart Jellyfin after installing or updating the connector. A pending restart is shown on the Servers page before it happens."
msgstr "Uruchom ponownie Jellyfin po zainstalowaniu lub aktualizacji konektora. Na stronie serwerów wyświetla się oczekiwany restart."

#: src/common/config.py:284
msgid "Wait for playback to finish"
msgstr "Poczekaj na zakończenie odtwarzania"

#: src/common/config.py:285
msgid "Defer connector restarts until there are no playing or paused streams."
msgstr "Odłożyć ponowne uruchamianie konektora do czasu braku odtwarzania lub wstrzymania strumienia."

#: src/common/config.py:288
msgid "Remove the older Themerr-jellyfin plugin"
msgstr "Usuń starszą wtyczkę Themerr-jellyfin"

#: src/common/config.py:289
msgid "After installing the connector, uninstall the older Themerr plugin and remove only its dedicated repository. Existing theme files are kept."
msgstr "Po zainstalowaniu konektora odinstaluj starszą wtyczkę Themerr i usuń tylko jego dedykowane repozytorium. Trzymane są istniejące pliki motywów."

#: src/common/config.py:293
msgid "Connector HTTP port"
msgstr "Port HTTP konektora"

#: src/common/config.py:294
msgid "Serve only connector downloads over HTTP when Themerr uses a self-signed certificate. The admin UI stays on HTTPS. Use 0 to disable. Restart Themerr after changing this port."
msgstr "Obsługa konektora pobieranego przez HTTP tylko wtedy, gdy Themerr używa certyfikatu z podpisem własnym. Interfejs administratora pozostaje na HTTPS. Użyj 0 aby wyłączyć. Uruchom ponownie Themerr po zmianie tego portu."

#: src/common/config.py:301
msgid "Plex"
msgstr "Plex"

#: src/common/config.py:302
msgid "Plex settings."
msgstr "Ustawienia Plex."

#: src/common/config.py:306
msgid "Plex URL"
msgstr "URL Plex"

#: src/common/config.py:307
msgid "The URL to the Plex server."
msgstr "Adres URL serwera Plex."

