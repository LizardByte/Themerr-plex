#: web/templates/config.html:34
msgid "Change password"
msgstr "變更密碼"

#: web/templates/config.html:36
msgid "All changes saved."
msgstr "所有變更已儲存。"

#: web/templates/config.html:36
msgid "Save changes"
msgstr "儲存變更"

