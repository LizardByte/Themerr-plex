msgid "Your session expired. Sign in to continue."
msgstr "Сесията Ви изтече. Влезте, за да продължите."

#: web/js/api.js:25
msgid "Dismiss message"
msgstr "Затвори съобщението"

#: web/js/config.js:18 web/js/config.js:44
msgid "Unsaved changes"
msgstr "Незапазени промени"

#: web/js/config.js:26
msgid "Discard unsaved settings changes?"
msgstr "Да се отменят незапазените промени в настройките?"

#: web/js/config.js:44 web/templates/config.html:36
msgid "All changes saved."
msgstr "Всички промени са запазени."

#: web/js/config.js:46
msgid "Settings saved. Network changes take effect after restarting Themerr."
msgstr "Настройките са запазени. Промените в мрежовите настройки влизат в сила след рестартиране на Themerr."

#: web/js/config.js:50
msgid "Unable to save changes."
msgstr "Не е възможно да се запазят промените."

#: web/js/config.js:58
msgid "Save your settings changes before changing your password."
msgstr "Запазете промените в настройките, преди да промените паролата си."

#: web/js/logs.js:117
msgid "No records match your filters."
msgstr "Няма записи, отговарящи на зададените от вас критерии."

#: web/js/logs.js:117 web/templates/logs.html:37
msgid "No log records yet."
msgstr "Все още няма записи в дневника."

#: web/js/logs.js:125
msgid "Search, filters, warning navigation, and download cover all loaded records since startup."
msgstr "Функциите за търсене, филтриране, навигация по предупрежденията и изтегляне обхващат всички заредени записи от момента на стартиране на програмата."

#: web/js/logs.js:126 web/templates/logs.html:28
msgid "Filters and search apply to the loaded records. Older history remains in the log directory."
msgstr "Филтрите и търсенето се прилагат към заредените записи. По-старите данни от историята остават в директорията с логове."

#: web/js/logs.js:144
msgid "Session log loading stalled."
msgstr "Забавяне при зареждането на лога на сесията."

#: web/js/logs.js:153 web/js/logs.js:206 web/templates/activity.html:5
msgid "Live"
msgstr "На живо"

#: web/js/logs.js:153 web/js/logs.js:206 web/templates/home.html:38
#: web/templates/servers.html:13
msgid "Paused"
msgstr "В пауза"

#: web/js/logs.js:185
msgid "Refresh failed. Showing the last loaded records."
msgstr "Опресняването се провали. Показват се последните заредени записи."

#: web/js/servers.js:13 web/templates/servers.html:25
msgid "Select libraries to ignore"
msgstr "Изберете библиотеките, които да бъдат пренебрегнати"

#: web/js/servers.js:22
msgid "Loading libraries…"
msgstr "Зареждане на библиотеки…"

#: web/js/servers.js:46
msgid "Showing cached libraries. Enable or reconnect this server to load its current libraries."
msgstr "Показват се библиотеки от кеша. Активирайте или се свържете отново с този сървър, за да се заредят актуалните му библиотеки."

#: web/js/servers.js:48
msgid "This server has no libraries."
msgstr "На този сървър няма библиотеки."

#: web/js/servers.js:54
msgid "Unable to load libraries. Your selections are kept. Close and reopen the list to retry."
msgstr "Не е възможно да се заредят библиотеките. Вашият избор е запазен. Затворете и отворете отново списъка, за да опитате отново."

#: web/templates/activity.html:3
msgid "See what Themerr is working on, and why an item might need your attention."
msgstr "Вижте върху какво работи Themerr и защо даден елемент може да изисква вашето внимание."

#: web/templates/activity.html:3
msgid "Scan for themes"
msgstr "Търсене по теми"

#: web/templates/activity.html:3 web/templates/logs.html:4
msgid "BEHIND THE MUSIC"
msgstr "ЗАД КУЛИСИТЕ НА МУЗИКАТА"

#: web/templates/activity.html:3 web/templates/navbar.html:6
msgid "Activity"
msgstr "Дейност"

#: web/templates/activity.html:4
msgid "items waiting in the processing queue"
msgstr "елементи, чакащи в опашката за обработка"

#: web/templates/activity.html:4
msgid "Task history covers the current application session."
msgstr "Историята на задачите обхваща текущата сесия на приложението."

#: web/templates/activity.html:5
