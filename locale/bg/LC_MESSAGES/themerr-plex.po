#: web/templates/navbar.html:6
msgid "Settings"
msgstr "Настройки"

#: src/themerr_plex.py:170
#, python-format
msgid "%(app_name)s manages theme songs for Plex.\n"
"Arguments supplied here are meant to be temporary."
msgstr "%(app_name)s управлява тематичните мелодии за Plex.\n"
"Параметрите, зададени тук, са предназначени за временно използване."

#: src/themerr_plex.py:174
msgid "Show this help message and exit"
msgstr "Покажи това съобщение за помощ и излез"

#: src/themerr_plex.py:176
msgid "Specify a config file to use"
msgstr "Посочете конфигурационния файл, който да се използва"

#: src/themerr_plex.py:177
msgid "Use debug logging level"
msgstr "Използване на ниво на отладочно логване"

#: src/themerr_plex.py:178
#, python-format
msgid "Start %(app_name)s in the development environment"
msgstr "Стартирайте %(app_name)s в средата за разработка"

#: src/themerr_plex.py:180
msgid "Health check the container and exit"
msgstr "Проверка на състоянието на контейнера и изход"

#: src/themerr_plex.py:183
#, python-format
msgid "Do not open %(app_name)s in browser"
msgstr "Не отваряйте %(app_name)s в браузъра"

#: src/themerr_plex.py:186
#, python-format
msgid "Force %(app_name)s to run on a specified port, default=9494"
msgstr "Принуди %(app_name)s да работи на зададен порт, по подразбиране=9494"

#: src/themerr_plex.py:189
msgid "Turn off console logging"
msgstr "Изключете записването в конзолата"

#: src/themerr_plex.py:190
msgid "Print the version details and exit"
msgstr "Отпечатай подробностите за версията и излез"

#: web/js/api.js:9
msgid "Your session expired. Sign in to continue."
msgstr "Сесията Ви изтече. Влезте, за да продължите."

#: web/js/api.js:25
msgid "Dismiss message"
msgstr "Затвори съобщението"

#: web/js/config.js:17 web/js/config.js:40
msgid "Unsaved changes"
msgstr "Незапазени промени"

#: web/js/config.js:40 web/templates/config.html:36
msgid "All changes saved."
msgstr "Всички промени са запазени."

#: web/js/config.js:42
msgid "Settings saved. Network changes take effect after restarting Themerr."
msgstr "Настройките са запазени. Промените в мрежовите настройки влизат в сила след рестартиране на Themerr."

#: web/js/config.js:46
msgid "Unable to save changes."
msgstr "Не е възможно да се запазят промените."

#: web/js/config.js:54
msgid "Save your settings changes before changing your password."
msgstr "Запазете промените в настройките, преди да промените паролата си."

#: web/templates/activity.html:3
msgid "BEHIND THE MUSIC"
msgstr "ЗАД КУЛИСИТЕ НА МУЗИКАТА"

#: web/templates/activity.html:3
msgid "See what Themerr is working on, and why an item might need your attention."
msgstr "Вижте върху какво работи Themerr и защо даден елемент може да изисква вашето внимание."

#: web/templates/activity.html:3
msgid "Scan for themes"
msgstr "Търсене по теми"

#: web/templates/activity.html:3 web/templates/navbar.html:6
msgid "Activity"
msgstr "Дейност"

#: web/templates/activity.html:4
msgid "items waiting in the processing queue"
msgstr "елементи, чакащи в опашката за обработка"

#: web/templates/activity.html:4
msgid "Task history covers the current application session."
msgstr "Историята на задачите обхваща текущата сесия на приложението."

#: web/templates/activity.html:5
msgid "Recent tasks"
msgstr "Последни задачи"

#: web/templates/activity.html:5
msgid "Live"
msgstr "На живо"

#: web/templates/activity.html:6
msgid "No tasks have run yet. Request a scan, or wait for the next scheduled refresh."
msgstr "Все още не са изпълнени задачи. Задайте сканиране или изчакайте следващото планирано обновяване."

#: web/templates/activity.html:7 web/templates/home.html:14
#: web/templates/home.html:31 web/templates/servers.html:13
msgid "Needs attention"
msgstr "Изисква внимание"

#: web/templates/activity.html:8
msgid "No processing failures recorded. All quiet here."
msgstr "Не са регистрирани грешки при обработката. Тук всичко е наред."

#: web/templates/activity.html:8 web/templates/home.html:62
msgid "Plex ID"
msgstr "Plex ID"

#: web/templates/activity.html:8 web/templates/home.html:76
msgid "Outdated from ThemerrDB"
msgstr "Остаряла информация от ThemerrDB"

#: web/templates/api_docs.html:7
msgid "Explore the API using your signed-in session."
msgstr "Разгледайте API-то, като използвате сесията си за вход."

#: web/templates/api_docs.html:7 web/templates/api_docs.html:8
#: web/templates/navbar.html:13
msgid "API documentation"
msgstr "Документация за API"

#: web/templates/auth.html:7
msgid "THE SOUND OF YOUR LIBRARY"
msgstr "ЗВУКЪТ НА ТВОЯТА БИБЛИОТЕКА"

#: web/templates/auth.html:8
msgid "Every story"
msgstr "Всяка история"

#: web/templates/auth.html:8
msgid "has a soundtrack."
msgstr "има саундтрак."

#: web/templates/auth.html:9
msgid "Bring your Plex libraries to life. One calm workspace for your servers, your themes, and everything in between."
msgstr "Вдъхнете живот на библиотеките си в Plex. Едно удобно работно пространство за вашите сървъри, теми и всичко останало."

#: web/templates/auth.html:18
msgid "Your workspace, secured."
msgstr "Вашето работно място – защитено."

#: web/templates/auth.html:19
msgid "Open the one-time setup link printed in the application console to create your admin account."
msgstr "Отворете линка за еднократна настройка, отпечатан в конзолата на приложението, за да създадете своя администраторски акаунт."

#: web/templates/auth.html:20
msgid "The link is generated each time the application starts, until setup is complete."
msgstr "Връзката се генерира при всяко стартиране на приложението, докато не приключи настройката."

#: web/templates/auth.html:22
msgid "GET STARTED"
msgstr "ЗАПОЧНИ"

#: web/templates/auth.html:22
msgid "WELCOME BACK"
msgstr "ДОБРЕ ДОШЛИ ОТНОВО"

#: web/templates/auth.html:23
msgid "Make it yours."
msgstr "Направи го свой."

#: web/templates/auth.html:23
msgid "Sign in to Themerr."
msgstr "Влезте в Themerr."

#: web/templates/auth.html:24
msgid "Create the administrator account for this installation."
msgstr "Създайте администраторския акаунт за тази инсталация."

#: web/templates/auth.html:24
msgid "Your libraries are waiting for their next soundtrack."
msgstr "Вашите библиотеки очакват следващия си саундтрак."

#: web/templates/auth.html:28
msgid "Username"
msgstr "Потребителско име"

#: web/templates/auth.html:30
msgid "Password"
msgstr "Парола"

#: web/templates/auth.html:33
msgid "Use at least 12 characters. A long, unique passphrase works well."
msgstr "Използвайте поне 12 символа. Дългата и уникална парола е най-подходяща."

#: web/templates/auth.html:34
msgid "Confirm password"
msgstr "Потвърдете паролата"

#: web/templates/auth.html:37
msgid "Create workspace"
msgstr "Създаване на работно пространство"

#: web/templates/auth.html:37
msgid "Sign in"
msgstr "Влез"

#: web/templates/auth.html:39
msgid "Plex account linking happens inside your workspace."
msgstr "Свързването на акаунта в Plex се извършва в рамките на вашето работно пространство."

#: web/templates/base.html:19
msgid "Skip to content"
msgstr "Премини към съдържанието"

#: web/templates/base.html:25
msgid "Toggle navigation"
msgstr "Превключване на навигацията"

#: web/templates/base.html:26
msgid "Workspace"
msgstr "Работно пространство"

#: web/templates/config.html:15
msgid "Browse directories for"
msgstr "Преглед на директориите за"

#: web/templates/config.html:22
msgid "TUNE YOUR WORKSPACE"
msgstr "ПРИСПОСОБЕТЕ РАБОТНОТО СИ МЯСТО"

#: web/templates/config.html:22
msgid "Make Themerr work the way your library does."
msgstr "Настройте Themerr така, че да работи по същия начин като вашата библиотека."

#: web/templates/config.html:24
msgid "Settings sections"
msgstr "Раздели „Настройки“"

#: web/templates/config.html:24 web/templates/config.html:33
msgid "Security"
msgstr "Сигурност"

#: web/templates/config.html:28
msgid "Server connections, data directories, and ignored libraries are managed on the Servers page."
msgstr "Връзките със сървърите, директориите с данни и игнорираните библиотеки се управляват на страницата „Сървъри“."

#: web/templates/config.html:28
