msgstr "Cài đặt ghi nhật ký."

#: src/common/config.py:167
msgid "Log directory"
msgstr "Thư mục nhật ký"

#: src/common/config.py:169
msgid "The directory where to store the log files."
msgstr "Thư mục dùng để lưu trữ các tệp nhật ký."

#: src/common/config.py:176
msgid "Debug logging"
msgstr "Ghi nhật ký gỡ lỗi"

#: src/common/config.py:178
msgid "Enable debug logging."
msgstr "Bật tính năng ghi nhật ký gỡ lỗi."

#: src/common/config.py:184
msgid "Network"
msgstr "Mạng"

#: src/common/config.py:185
msgid "Network settings."
msgstr "Cài đặt mạng."

#: src/common/config.py:189
msgid "HTTP host address"
msgstr "Địa chỉ máy chủ HTTP"

#: src/common/config.py:191
msgid "The HTTP address to bind to."
msgstr "Địa chỉ HTTP cần liên kết."

#: src/common/config.py:200
msgid "HTTP port"
msgstr "Cổng HTTP"

#: src/common/config.py:202
msgid "Port to bind web server to. Note that ports below 1024 may require root."
msgstr "Cổng để kết nối với máy chủ web. Lưu ý rằng các cổng dưới 1024 có thể yêu cầu quyền root."

#: src/common/config.py:210
msgid "HTTP root"
msgstr "Thư mục gốc HTTP"

#: src/common/config.py:212
msgid "Todo: The base URL of the web server. Used for reverse proxies."
msgstr "Todo: URL cơ sở của máy chủ web. Được sử dụng cho các máy chủ proxy ngược."

#: src/common/config.py:217
msgid "SSL"
msgstr "SSL"

#: src/common/config.py:219
msgid "Run the web server with HTTPS. Disabling this can be a security risk, do so at your own risk."
msgstr "Chạy máy chủ web bằng HTTPS. Việc tắt tính năng này có thể gây ra rủi ro bảo mật; nếu bạn quyết định tắt, hãy tự chịu trách nhiệm về hậu quả."

#: src/common/config.py:225
msgid "Updater"
msgstr "Trình cập nhật"

#: src/common/config.py:226
msgid "Updater settings."
msgstr "Cài đặt trình cập nhật."

#: src/common/config.py:230
msgid "Auto update"
msgstr "Cập nhật tự động"

#: src/common/config.py:238
msgid "Jellyfin"
msgstr "Jellyfin"

#: src/common/config.py:239
msgid "Jellyfin theme processing settings. Connections are managed on the Servers page."
msgstr "Cài đặt xử lý chủ đề Jellyfin. Các kết nối được quản lý trên trang Máy chủ."

#: src/common/config.py:242 src/common/config.py:343
msgid "Movie support"
msgstr "Hỗ trợ phim"

#: src/common/config.py:243
msgid "Add themes to Jellyfin movies."
msgstr "Thêm chủ đề vào các bộ phim trên Jellyfin."

#: src/common/config.py:246 src/common/config.py:349
msgid "Series support"
msgstr "Hỗ trợ chuỗi"

#: src/common/config.py:247
msgid "Add themes to Jellyfin series."
msgstr "Thêm chủ đề vào các loạt phim trên Jellyfin."

#: src/common/config.py:250 src/common/config.py:337 web/templates/home.html:31
msgid "Collections"
msgstr "Bộ sưu tập"

#: src/common/config.py:251
msgid "Add themes inside Jellyfin’s collection directories. Media files can remain elsewhere."
msgstr "Thêm các chủ đề vào các thư mục bộ sưu tập của Jellyfin. Các tệp phương tiện vẫn có thể được lưu trữ ở nơi khác."

#: src/common/config.py:254
msgid "Overwrite user themes"
msgstr "Ghi đè chủ đề của người dùng"

#: src/common/config.py:255
msgid "Replace existing theme files, including themes created by the older Themerr-jellyfin plugin."
msgstr "Thay thế các tệp chủ đề hiện có, bao gồm cả các chủ đề được tạo bởi plugin Themerr-jellyfin phiên bản cũ."

#: src/common/config.py:259
msgid "Back up replaced user themes"
msgstr "Sao lưu các chủ đề người dùng đã được thay thế"

#: src/common/config.py:260
msgid "Keep existing user themes in a backup folder when replacing them. Disable to permanently remove replaced themes."
msgstr "Khi thay thế các chủ đề của người dùng hiện có, hãy lưu chúng vào thư mục sao lưu. Tắt tính năng này để xóa vĩnh viễn các chủ đề đã được thay thế."

#: src/common/config.py:264
msgid "Import older Themerr-jellyfin ownership"
msgstr "Nhập thông tin quyền sở hữu Themerr-jellyfin từ trước đây"

#: src/common/config.py:265
msgid "Recognize themes recorded in the older plugin’s database only when their SHA-256 still matches. Changed files stay protected. The old database is left untouched."
msgstr "Chỉ nhận diện các chủ đề được lưu trong cơ sở dữ liệu của plugin cũ khi mã SHA-256 của chúng vẫn trùng khớp. Các tệp đã thay đổi vẫn được bảo vệ. Cơ sở dữ liệu cũ vẫn được giữ nguyên."

#: src/common/config.py:269
msgid "Ignore locked metadata"
msgstr "Bỏ qua siêu dữ liệu bị khóa"

#: src/common/config.py:270
msgid "Allow Jellyfin theme updates for items with locked metadata."
msgstr "Cho phép cập nhật chủ đề Jellyfin cho các mục có siêu dữ liệu bị khóa."

#: src/common/config.py:273
msgid "Update connector automatically"
msgstr "Tự động cập nhật trình kết nối"

#: src/common/config.py:274
msgid "Install the matching connector when Themerr starts or detects a version mismatch. Set the reachable Themerr address on the Servers page first."
msgstr "Hãy cài đặt trình kết nối tương ứng khi Themerr khởi động hoặc phát hiện sự không khớp về phiên bản. Trước tiên, hãy thiết lập địa chỉ Themerr có thể truy cập được trên trang “Máy chủ”."

#: src/common/config.py:278
msgid "Restart Jellyfin automatically"
msgstr "Tự động khởi động lại Jellyfin"

#: src/common/config.py:279
msgid "Restart Jellyfin after installing or updating the connector. A pending restart is shown on the Servers page before it happens."
msgstr "Hãy khởi động lại Jellyfin sau khi cài đặt hoặc cập nhật trình kết nối. Một thông báo về việc khởi động lại đang chờ xử lý sẽ hiển thị trên trang Máy chủ trước khi quá trình này diễn ra."

#: src/common/config.py:283
msgid "Wait for playback to finish"
msgstr "Chờ cho đến khi quá trình phát lại kết thúc"

#: src/common/config.py:284
msgid "Defer connector restarts until there are no playing or paused streams."
msgstr "Hoãn việc khởi động lại bộ kết nối cho đến khi không còn luồng nào đang phát hoặc đang tạm dừng."

#: src/common/config.py:287
msgid "Remove the older Themerr-jellyfin plugin"
msgstr "Gỡ bỏ plugin Themerr-jellyfin phiên bản cũ"

#: src/common/config.py:288
msgid "After installing the connector, uninstall the older Themerr plugin and remove only its dedicated repository. Existing theme files are kept."
msgstr "Sau khi cài đặt trình kết nối, hãy gỡ cài đặt plugin Themerr phiên bản cũ và chỉ xóa kho lưu trữ dành riêng cho plugin đó. Các tệp chủ đề hiện có sẽ được giữ nguyên."

#: src/common/config.py:292
msgid "Connector HTTP port"
msgstr "Cổng HTTP của bộ kết nối"

#: src/common/config.py:293
msgid "Serve only connector downloads over HTTP when Themerr uses a self-signed certificate. The admin UI stays on HTTPS. Use 0 to disable. Restart Themerr after changing this port."
msgstr "Chỉ cho phép tải xuống các trình kết nối qua HTTP khi Themerr sử dụng chứng chỉ tự ký. Giao diện quản trị vẫn hoạt động trên HTTPS. Sử dụng giá trị 0 để tắt tính năng này. Khởi động lại Themerr sau khi thay đổi cổng này."

#: src/common/config.py:300
msgid "Plex"
msgstr "Plex"

#: src/common/config.py:301
msgid "Plex settings."
msgstr "Cài đặt Plex."

#: src/common/config.py:305
msgid "Plex URL"
msgstr "URL Plex"

#: src/common/config.py:306
msgid "The URL to the Plex server."
msgstr "Địa chỉ URL của máy chủ Plex."

#: src/common/config.py:315 web/templates/servers.html:37
msgid "Plex data directory"
msgstr "Thư mục dữ liệu Plex"

#: src/common/config.py:316
msgid "https://support.plex.tv/articles/202915258-where-is-the-plex-media-server-data-directory-located/"
msgstr "https://support.plex.tv/articles/202915258-where-is-the-plex-media-server-data-directory-located/"

#: src/common/config.py:326
msgid "Themerr"
msgstr "Themerr"

#: src/common/config.py:327
msgid "Themerr settings."
msgstr "Cài đặt Themerr."

#: src/common/config.py:331
msgid "Themerr Enabled"
msgstr "Đã bật Themerr"

#: src/common/config.py:332
msgid "When enabled, Themerr will attempt to update themes."
msgstr "Khi được bật, Themerr sẽ cố gắng cập nhật các chủ đề."

#: src/common/config.py:338
msgid "Add themes to collections."
msgstr "Thêm chủ đề vào bộ sưu tập."

#: src/common/config.py:344
msgid "Add themes to movies using the Plex Movie agent."
msgstr "Thêm chủ đề vào phim bằng trình quản lý phim Plex."

#: src/common/config.py:350
msgid "Add themes to series using the Plex Series agent."
msgstr "Thêm chủ đề vào các bộ phim bằng trình quản lý Plex Series."

#: src/common/config.py:355
msgid "Overwrite Plex themes"
msgstr "Ghi đè các chủ đề Plex"

#: src/common/config.py:356
msgid "When enabled, Themerr will overwrite themes provided by Plex."
msgstr "Khi được bật, Themerr sẽ ghi đè lên các chủ đề do Plex cung cấp."

#: src/common/config.py:361
msgid "Prefer MP4A AAC Codec"
msgstr "Ưu tiên codec MP4A AAC"

#: src/common/config.py:362
msgid "This can improve theme compatibility with Apple devices."
msgstr "Điều này có thể giúp cải thiện khả năng tương thích của chủ đề với các thiết bị của Apple."

#: src/common/config.py:367
msgid "Remove unused themes"
msgstr "Xóa các chủ đề không sử dụng"

#: src/common/config.py:368
msgid "Frees up space in your Plex metadata directory. This option requires that the \"Plex data directory\" path is set"
msgstr "Giải phóng dung lượng trong thư mục siêu dữ liệu Plex của bạn. Tùy chọn này yêu cầu phải thiết lập đường dẫn “thư mục dữ liệu Plex”"

#: src/common/config.py:374
msgid "Remove unused art"
msgstr "Xóa các hình ảnh không sử dụng"

#: src/common/config.py:375 src/common/config.py:383
msgid "Applies to collection. Frees up space in your Plex metadata directory. This option requires that the \"Plex data directory\" path is set"
msgstr "Áp dụng cho bộ sưu tập. Giải phóng dung lượng trong thư mục siêu dữ liệu Plex của bạn. Tùy chọn này yêu cầu đường dẫn “Thư mục dữ liệu Plex” phải được thiết lập"

#: src/common/config.py:382
msgid "Remove unused posters"
msgstr "Gỡ bỏ các áp phích không sử dụng"

#: src/common/config.py:390
msgid "Collection metadata"
msgstr "Siêu dữ liệu bộ sưu tập"

#: src/common/config.py:391
msgid "Update collection metadata (poster, art, and summary) during scheduled update."
msgstr "Cập nhật siêu dữ liệu của bộ sưu tập (áp phích, hình ảnh và tóm tắt) trong quá trình cập nhật theo lịch trình."

#: src/common/config.py:396
msgid "Ignore locked fields."
msgstr "Bỏ qua các trường bị khóa."

#: src/common/config.py:397
msgid "If you used Themerr v2024.813.13709 or lower, you may need to enable this to update items."
msgstr "Nếu bạn đang sử dụng Themerr phiên bản v2024.813.13709 hoặc các phiên bản cũ hơn, bạn có thể cần phải kích hoạt tính năng này để cập nhật các mục."

#: src/common/config.py:403
msgid "Ignored library IDs"
msgstr "Các ID thư viện bị bỏ qua"

#: src/common/config.py:404
msgid "Comma-separated library IDs to exclude from scheduled updates. IDs appear on Home."
msgstr "Các ID thư viện được phân tách bằng dấu phẩy cần loại trừ khỏi các bản cập nhật theo lịch trình. Các ID này hiển thị trên trang Chủ."

#: src/common/config.py:410
msgid "Update themes interval"
msgstr "Cập nhật khoảng thời gian thay đổi chủ đề"

#: src/common/config.py:411
msgid "Interval for automatic update task, in minutes (min: 15)."
msgstr "Khoảng thời gian cho tác vụ cập nhật tự động, tính bằng phút (tối thiểu: 15)."

#: src/common/config.py:418
msgid "Update database cache interval"
msgstr "Cập nhật khoảng thời gian lưu trữ bộ nhớ đệm cơ sở dữ liệu"

#: src/common/config.py:419
msgid "Interval for database cache update task, in minutes (min: 15)."
msgstr "Khoảng thời gian thực hiện tác vụ cập nhật bộ nhớ đệm cơ sở dữ liệu, tính bằng phút (tối thiểu: 15)."

#: src/common/config.py:426
msgid "PlexAPI timeout"
msgstr "Thời gian chờ của PlexAPI"

#: src/common/config.py:427
msgid "Increase this slightly if you experience timeouts when adding themes. (min: 1)"
msgstr "Hãy tăng giá trị này lên một chút nếu bạn gặp phải tình trạng hết thời gian chờ khi thêm chủ đề. (tối thiểu: 1)"

#: src/common/config.py:434
msgid "Theme upload retries"
msgstr "Số lần thử lại khi tải lên chủ đề"

#: src/common/config.py:435
msgid "If uploading themes fail, retry this many times. (min: 0)"
msgstr "Nếu việc tải lên chủ đề không thành công, hãy thử lại số lần này. (tối thiểu: 0)"

#: src/common/config.py:442
msgid "Multiprocessing thread count"
msgstr "Số luồng trong xử lý đa luồng"

#: src/common/config.py:443
msgid "The number of threads to use when adding themes. Restart required. (min: 1)"
msgstr "Số luồng cần sử dụng khi thêm chủ đề. Cần khởi động lại. (tối thiểu: 1)"

#: src/common/config.py:450
msgid "YouTube Cookies"
msgstr "Cookie của YouTube"

#: src/common/config.py:452
msgid "Optional: export youtube.com cookies with Get cookies.txt LOCALLY using its JSON format, then paste the entire JSON array here and save. Cookies contain your browser session; keep them private."
msgstr "Tùy chọn: Xuất các tệp cookie từ youtube.com bằng công cụ “Get cookies.txt” dưới dạng tệp cục bộ (LOCALLY) theo định dạng JSON, sau đó dán toàn bộ mảng JSON vào đây và lưu lại. Các tệp cookie chứa thông tin phiên làm việc của trình duyệt; hãy giữ chúng ở chế độ riêng tư."

#: src/common/config.py:457
msgid "Cookie export instructions"
msgstr "Hướng dẫn xuất cookie"

