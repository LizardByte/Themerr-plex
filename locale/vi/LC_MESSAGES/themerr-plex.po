msgstr "Buộc %(app_name)s chạy trên cổng được chỉ định, mặc định là 9494"

#: src/themerr_plex.py:189
msgid "Turn off console logging"
msgstr "Tắt tính năng ghi nhật ký trên bảng điều khiển"

#: src/themerr_plex.py:190
msgid "Print the version details and exit"
msgstr "In thông tin phiên bản và thoát"

#: web/templates/activity.html:3
msgid "BEHIND THE MUSIC"
msgstr "PHÍA SAU NHỮNG BẢN NHẠC"

#: web/templates/activity.html:3
msgid "See what Themerr is working on, and why an item might need your attention."
msgstr "Hãy xem Themerr đang làm gì và tại sao một mục nào đó có thể cần sự chú ý của bạn."

#: web/templates/activity.html:3
msgid "Scan for themes"
msgstr "Tìm kiếm theo chủ đề"

#: web/templates/activity.html:3 web/templates/navbar.html:6
msgid "Activity"
msgstr "Hoạt động"

#: web/templates/activity.html:4
msgid "items waiting in the processing queue"
msgstr "các mục đang chờ xử lý trong hàng đợi"

#: web/templates/activity.html:4
msgid "Task history covers the current application session."
msgstr "Lịch sử tác vụ bao gồm phiên làm việc hiện tại của ứng dụng."

#: web/templates/activity.html:5
msgid "Recent tasks"
msgstr "Các nhiệm vụ gần đây"

#: web/templates/activity.html:5
msgid "Live"
msgstr "Trực tiếp"

#: web/templates/activity.html:6
msgid "No tasks have run yet. Request a scan, or wait for the next scheduled refresh."
msgstr "Chưa có tác vụ nào được thực thi. Hãy yêu cầu quét hoặc đợi đến lần làm mới theo lịch trình tiếp theo."

#: web/templates/activity.html:7 web/templates/home.html:14
#: web/templates/home.html:31 web/templates/servers.html:13
msgid "Needs attention"
msgstr "Cần chú ý"

#: web/templates/activity.html:8
msgid "No processing failures recorded. All quiet here."
msgstr "Không ghi nhận sự cố xử lý nào. Mọi thứ vẫn ổn ở đây."

#: web/templates/activity.html:8 web/templates/home.html:62
msgid "Plex ID"
msgstr "ID Plex"

#: web/templates/activity.html:8 web/templates/home.html:76
msgid "Outdated from ThemerrDB"
msgstr "Đã lỗi thời từ ThemerrDB"

#: web/templates/auth.html:7
msgid "THE SOUND OF YOUR LIBRARY"
msgstr "ÂM THANH TỪ THƯ VIỆN CỦA BẠN"

#: web/templates/auth.html:8
msgid "Every story"
msgstr "Mỗi câu chuyện"

#: web/templates/auth.html:8
msgid "has a soundtrack."
msgstr "có nhạc nền."

#: web/templates/auth.html:9
msgid "Bring your Plex libraries to life. One calm workspace for your servers, your themes, and everything in between."
msgstr "Hãy thổi hồn vào các thư viện Plex của bạn. Một không gian làm việc gọn gàng và dễ chịu dành cho các máy chủ, các chủ đề và mọi thứ khác của bạn."

#: web/templates/auth.html:18
msgid "Your workspace, secured."
msgstr "Không gian làm việc của bạn, được bảo mật."

#: web/templates/auth.html:19
msgid "Open the one-time setup link printed in the application console to create your admin account."
msgstr "Hãy mở liên kết thiết lập một lần được in trong bảng điều khiển ứng dụng để tạo tài khoản quản trị viên của bạn."

#: web/templates/auth.html:20
msgid "The link is generated each time the application starts, until setup is complete."
msgstr "Liên kết này được tạo ra mỗi khi ứng dụng khởi động, cho đến khi quá trình cài đặt hoàn tất."

#: web/templates/auth.html:22
msgid "GET STARTED"
msgstr "BẮT ĐẦU"

#: web/templates/auth.html:22
msgid "WELCOME BACK"
msgstr "CHÀO MỪNG BẠN TRỞ LẠI"

#: web/templates/auth.html:23
msgid "Make it yours."
msgstr "Hãy biến nó thành của riêng bạn."

#: web/templates/auth.html:23
msgid "Sign in to Themerr."
msgstr "Đăng nhập vào Themerr."

#: web/templates/auth.html:24
msgid "Create the administrator account for this installation."
msgstr "Tạo tài khoản quản trị viên cho bản cài đặt này."

#: web/templates/auth.html:24
msgid "Your libraries are waiting for their next soundtrack."
msgstr "Các thư viện của bạn đang chờ đón bản nhạc nền tiếp theo."

#: web/templates/auth.html:28
msgid "Username"
msgstr "Tên người dùng"

#: web/templates/auth.html:30
msgid "Password"
msgstr "Mật khẩu"

#: web/templates/auth.html:33
msgid "Use at least 12 characters. A long, unique passphrase works well."
msgstr "Hãy sử dụng ít nhất 12 ký tự. Một cụm mật khẩu dài và độc đáo sẽ rất hiệu quả."

#: web/templates/auth.html:34
msgid "Confirm password"
msgstr "Xác nhận mật khẩu"

#: web/templates/auth.html:37
msgid "Create workspace"
msgstr "Tạo không gian làm việc"

#: web/templates/auth.html:37
msgid "Sign in"
msgstr "Đăng nhập"

#: web/templates/auth.html:39
msgid "Plex account linking happens inside your workspace."
msgstr "Việc liên kết tài khoản Plex được thực hiện ngay trong không gian làm việc của bạn."

#: web/templates/base.html:19
msgid "Skip to content"
msgstr "Chuyển thẳng đến nội dung"

#: web/templates/base.html:25
msgid "Toggle navigation"
msgstr "Chuyển đổi thanh điều hướng"

#: web/templates/base.html:26
msgid "Workspace"
msgstr "Không gian làm việc"

#: web/templates/config.html:15
msgid "Browse directories for"
msgstr "Duyệt qua các thư mục để tìm"

#: web/templates/config.html:22
msgid "TUNE YOUR WORKSPACE"
msgstr "TỐI ƯU HÓA KHÔNG GIAN LÀM VIỆC CỦA BẠN"

#: web/templates/config.html:22
msgid "Make Themerr work the way your library does."
msgstr "Hãy làm cho Themerr hoạt động giống như thư viện của bạn."

#: web/templates/config.html:24
msgid "Settings sections"
msgstr "Các phần cài đặt"

