msgstr "Sử dụng mức ghi nhật ký gỡ lỗi"

#: src/themerr_plex.py:178
#, python-format
msgid "Start %(app_name)s in the development environment"
msgstr "Khởi động %(app_name)s trong môi trường phát triển"

