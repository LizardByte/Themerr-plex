msgstr "Kiểm tra tình trạng của container và thoát ra"

#: src/themerr_plex.py:183
#, python-format
msgid "Do not open %(app_name)s in browser"
msgstr "Không mở trang web %(app_name)s trong trình duyệt"

#: src/themerr_plex.py:186
#, python-format
