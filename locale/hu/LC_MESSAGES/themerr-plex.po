msgstr "Todo: A webszerver alap-URL-je. Fordított proxy-k esetén használatos."

#: src/common/config.py:197
msgid "SSL"
msgstr "SSL"

#: src/common/config.py:199
msgid "Run the web server with HTTPS. Disabling this can be a security risk, do so at your own risk."
msgstr "Indítsa el a webszervert HTTPS-en keresztül. Ennek letiltása biztonsági kockázatot jelenthet, ezért ezt saját felelősségére tegye."

#: src/common/config.py:205
msgid "Updater"
msgstr "Frissítő"

#: src/common/config.py:206
msgid "Updater settings."
msgstr "A frissítő beállításai."

#: src/common/config.py:210
msgid "Auto update"
msgstr "Automatikus frissítés"

#: src/common/config.py:218
msgid "Plex"
msgstr "Plex"

#: src/common/config.py:219
msgid "Plex settings."
msgstr "A Plex beállításai."

#: src/common/config.py:223
msgid "Plex URL"
msgstr "Plex URL"

#: src/common/config.py:224
msgid "The URL to the Plex server."
msgstr "A Plex-kiszolgáló URL-címe."

