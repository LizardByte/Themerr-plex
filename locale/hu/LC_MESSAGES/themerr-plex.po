#: web/templates/activity.html:3
msgid "BEHIND THE MUSIC"
msgstr "A ZENE MÖGÖTT"

#: web/templates/activity.html:3
msgid "See what Themerr is working on, and why an item might need your attention."
msgstr "Nézd meg, min dolgozik jelenleg a Themerr, és miért lehet, hogy egy elemre oda kell figyelned."

#: web/templates/activity.html:3
msgid "Scan for themes"
msgstr "Témák keresése"

#: web/templates/activity.html:3 web/templates/navbar.html:6
msgid "Activity"
msgstr "Tevékenység"

#: web/templates/activity.html:4
msgid "items waiting in the processing queue"
msgstr "a feldolgozási sorban várakozó tételek"

#: web/templates/activity.html:4
msgid "Task history covers the current application session."
msgstr "A feladatok előzményei az aktuális alkalmazás-munkamenetet fedik le."

#: web/templates/activity.html:5
msgid "Recent tasks"
msgstr "Legutóbbi feladatok"

#: web/templates/activity.html:5
msgid "Live"
msgstr "Élőben"

#: web/templates/activity.html:6
msgid "No tasks have run yet. Request a scan, or wait for the next scheduled refresh."
msgstr "Még nem futott le egyetlen feladat sem. Kérjen lefutást, vagy várja meg a következő ütemezett frissítést."

#: web/templates/activity.html:7 web/templates/home.html:14
#: web/templates/home.html:31 web/templates/servers.html:13
msgid "Needs attention"
msgstr "Figyelmet igényel"

#: web/templates/activity.html:8
msgid "No processing failures recorded. All quiet here."
msgstr "Feldolgozási hiba nem történt. Itt minden rendben."

#: web/templates/activity.html:8 web/templates/home.html:62
msgid "Plex ID"
msgstr "Plex-azonosító"

#: web/templates/activity.html:8 web/templates/home.html:76
msgid "Outdated from ThemerrDB"
msgstr "A ThemerrDB-ből elavult"

#: web/templates/api_docs.html:7
msgid "Explore the API using your signed-in session."
msgstr "Fedezze fel az API-t a bejelentkezett munkamenet segítségével."

#: web/templates/api_docs.html:7 web/templates/api_docs.html:8
#: web/templates/navbar.html:13
msgid "API documentation"
msgstr "API-dokumentáció"

#: web/templates/auth.html:7
msgid "THE SOUND OF YOUR LIBRARY"
msgstr "A KÖNYVTÁR HANGJA"

#: web/templates/auth.html:8
msgid "Every story"
msgstr "Minden történet"

#: web/templates/auth.html:8
msgid "has a soundtrack."
msgstr "van hozzá filmzene."

#: web/templates/auth.html:9
msgid "Bring your Plex libraries to life. One calm workspace for your servers, your themes, and everything in between."
msgstr "Élessze meg Plex-könyvtárait! Egy áttekinthető munkaterület a szerverekhez, a témákhoz és minden egyébhez."

#: web/templates/auth.html:18
msgid "Your workspace, secured."
msgstr "A munkaterületed biztonságban van."

#: web/templates/auth.html:19
msgid "Open the one-time setup link printed in the application console to create your admin account."
msgstr "Nyissa meg az alkalmazáskonzolban kinyomtatott egyszeri beállítási linket az adminisztrátori fiók létrehozásához."

#: web/templates/auth.html:20
msgid "The link is generated each time the application starts, until setup is complete."
msgstr "A link az alkalmazás minden indításakor létrejön, amíg a beállítás be nem fejeződik."

#: web/templates/auth.html:22
msgid "GET STARTED"
msgstr "Kezdés"

#: web/templates/auth.html:22
msgid "WELCOME BACK"
msgstr "ÜDVÖZÖLJÜK ÚJRA!"

#: web/templates/auth.html:23
msgid "Make it yours."
msgstr "Tedd a sajátoddá!"

#: web/templates/auth.html:23
msgid "Sign in to Themerr."
msgstr "Jelentkezz be a Themerr-be."

#: web/templates/auth.html:24
msgid "Create the administrator account for this installation."
msgstr "Hozza létre a telepítéshez tartozó rendszergazdai fiókot."

#: web/templates/auth.html:24
msgid "Your libraries are waiting for their next soundtrack."
msgstr "A könyvtáraid már alig várják a következő zenei aláfestést."

#: web/templates/auth.html:28
msgid "Username"
msgstr "Felhasználónév"

#: web/templates/auth.html:30
msgid "Password"
msgstr "Jelszó"

#: web/templates/auth.html:33
msgid "Use at least 12 characters. A long, unique passphrase works well."
msgstr "Legalább 12 karaktert használjon. Egy hosszú, egyedi jelszó jól bevált."

#: web/templates/auth.html:34
msgid "Confirm password"
msgstr "Jelszó megerősítése"

#: web/templates/auth.html:37
msgid "Create workspace"
msgstr "Munkaterület létrehozása"

#: web/templates/auth.html:37
msgid "Sign in"
msgstr "Bejelentkezés"

#: web/templates/auth.html:39
msgid "Plex account linking happens inside your workspace."
msgstr "A Plex-fiók összekapcsolása a munkaterületeden belül történik."

#: web/templates/base.html:19
msgid "Skip to content"
msgstr "Tartalomra ugrás"

#: web/templates/base.html:25
msgid "Toggle navigation"
msgstr "Navigáció váltása"

#: web/templates/base.html:26
msgid "Workspace"
msgstr "Munkaterület"

#: web/templates/config.html:15
msgid "Browse directories for"
msgstr "Keresés a könyvtárakban a következőkre:"

#: web/templates/config.html:22
msgid "TUNE YOUR WORKSPACE"
msgstr "ÁLLÍTSD BE A MUNKAKÖRNYEZETEDET"

#: web/templates/config.html:22
msgid "Make Themerr work the way your library does."
msgstr "Állítsd be a Themerr-t úgy, hogy úgy működjön, ahogyan a könyvtárad."

#: web/templates/config.html:24
msgid "Settings sections"
msgstr "Beállítások szakaszok"

#: web/templates/config.html:24 web/templates/config.html:33
msgid "Security"
msgstr "Biztonság"

#: web/templates/config.html:28
msgid "Server connections, data directories, and ignored libraries are managed on the Servers page."
msgstr "A szerverkapcsolatok, az adatkönyvtárak és az ignorált könyvtárak kezelése a „Szerverek” oldalon történik."

#: web/templates/config.html:28
msgid "Changes to network settings take effect after restarting Themerr."
msgstr "A hálózati beállítások módosításai a Themerr újraindítása után lépnek életbe."

#: web/templates/config.html:33
msgid "One administrator for this installation. Change your password and sign out other sessions."
msgstr "Ennek a telepítésnek egy rendszergazdája van. Módosítsa a jelszavát, és jelentkezzen ki az egyéb munkamenetekből."

#: web/templates/config.html:34
msgid "Current password"
msgstr "Jelenlegi jelszó"

#: web/templates/config.html:34
msgid "New password"
msgstr "Új jelszó"

#: web/templates/config.html:34
msgid "Confirm new password"
msgstr "Az új jelszó megerősítése"

#: web/templates/config.html:34
msgid "Change password"
msgstr "Jelszó módosítása"

#: web/templates/config.html:36
msgid "Save changes"
msgstr "Módosítások mentése"

#: web/templates/directory_picker.html:2
msgid "Choose an application directory"
msgstr "Válasszon ki egy alkalmazáskönyvtárat"

#: web/templates/directory_picker.html:2
msgid "Close directory picker"
msgstr "A könyvtárválasztó bezárása"

