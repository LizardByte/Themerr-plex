msgstr "https://support.plex.tv/articles/202915258-where-is-the-plex-media-server-data-directory-located/"

#: src/common/config.py:326
msgid "Themerr"
msgstr "Themerr"

#: src/common/config.py:327
msgid "Themerr settings."
msgstr "Themerr beállítások."

#: src/common/config.py:331
msgid "Themerr Enabled"
msgstr "Themerr engedélyezve"

#: src/common/config.py:332
msgid "When enabled, Themerr will attempt to update themes."
msgstr "Ha engedélyezve van, a Themerr megpróbálja frissíteni a témákat."

#: src/common/config.py:338
msgid "Add themes to collections."
msgstr "Témák hozzáadása gyűjteményekhez."

#: src/common/config.py:344
msgid "Add themes to movies using the Plex Movie agent."
msgstr "A Plex Movie ügynök segítségével témákat adhat hozzá a filmekhez."

#: src/common/config.py:350
msgid "Add themes to series using the Plex Series agent."
msgstr "A Plex Series ügynök segítségével témákat adhat hozzá sorozatokhoz."

#: src/common/config.py:355
msgid "Overwrite Plex themes"
msgstr "A Plex-témák felülírása"

#: src/common/config.py:356
msgid "When enabled, Themerr will overwrite themes provided by Plex."
msgstr "Ha engedélyezve van, a Themerr felülírja a Plex által biztosított témákat."

#: src/common/config.py:361
msgid "Prefer MP4A AAC Codec"
msgstr "Az MP4A AAC kodeket részesítsd előnyben"

#: src/common/config.py:362
msgid "This can improve theme compatibility with Apple devices."
msgstr "Ez javíthatja a téma kompatibilitását az Apple-eszközökkel."

#: src/common/config.py:367
msgid "Remove unused themes"
msgstr "A fel nem használt témák eltávolítása"

#: src/common/config.py:368
msgid "Frees up space in your Plex metadata directory. This option requires that the \"Plex data directory\" path is set"
msgstr "Helyet szabadít fel a Plex metaadat-könyvtárában. Ehhez az opcióhoz be kell állítani a „Plex adatkönyvtár” elérési útját"

#: src/common/config.py:374
msgid "Remove unused art"
msgstr "A fel nem használt illusztrációk eltávolítása"

#: src/common/config.py:375 src/common/config.py:383
msgid "Applies to collection. Frees up space in your Plex metadata directory. This option requires that the \"Plex data directory\" path is set"
msgstr "A gyűjteményre vonatkozik. Helyet szabadít fel a Plex metaadat-könyvtárában. Ehhez az opcióhoz be kell állítani a „Plex adatkönyvtár” elérési útját"

#: src/common/config.py:382
msgid "Remove unused posters"
msgstr "A felesleges plakátok eltávolítása"

#: src/common/config.py:390
msgid "Collection metadata"
msgstr "A gyűjtemény metaadatai"

#: src/common/config.py:391
msgid "Update collection metadata (poster, art, and summary) during scheduled update."
msgstr "A tervezett frissítés során frissítse a gyűjtemény metaadatait (plakát, illusztráció és összefoglaló)."

#: src/common/config.py:396
msgid "Ignore locked fields."
msgstr "A lezárt mezőket hagyja figyelmen kívül."

#: src/common/config.py:397
msgid "If you used Themerr v2024.813.13709 or lower, you may need to enable this to update items."
msgstr "Ha a Themerr v2024.813.13709 vagy annál korábbi verziót használtad, előfordulhat, hogy ezt engedélyezned kell az elemek frissítéséhez."

#: src/common/config.py:403
msgid "Ignored library IDs"
msgstr "Figyelmen kívül hagyott könyvtár-azonosítók"

#: src/common/config.py:404
msgid "Comma-separated library IDs to exclude from scheduled updates. IDs appear on Home."
msgstr "Vesszővel elválasztott könyvtár-azonosítók, amelyeket ki kell zárni a tervezett frissítésekből. Az azonosítók a Főoldalon jelennek meg."

#: src/common/config.py:410
msgid "Update themes interval"
msgstr "A témák frissítésének gyakorisága"

#: src/common/config.py:411
msgid "Interval for automatic update task, in minutes (min: 15)."
msgstr "Az automatikus frissítési feladat időköz, percben kifejezve (min.: 15)."

#: src/common/config.py:418
msgid "Update database cache interval"
msgstr "Az adatbázis-gyorsítótár frissítési időközének módosítása"

#: src/common/config.py:419
msgid "Interval for database cache update task, in minutes (min: 15)."
msgstr "Az adatbázis-gyorsítótár frissítési feladatának időköz, percben kifejezve (min.: 15)."

#: src/common/config.py:426
msgid "PlexAPI timeout"
msgstr "PlexAPI időtúllépés"

#: src/common/config.py:427
msgid "Increase this slightly if you experience timeouts when adding themes. (min: 1)"
msgstr "Ha a témák hozzáadása során időtúllépés lép fel, növelje ezt az értéket kissé. (min.: 1)"

#: src/common/config.py:434
msgid "Theme upload retries"
msgstr "A téma feltöltésének újrapróbálkozásai"

#: src/common/config.py:435
msgid "If uploading themes fail, retry this many times. (min: 0)"
msgstr "Ha a témák feltöltése sikertelen, ennyiszer próbálja meg újra. (min.: 0)"

#: src/common/config.py:442
msgid "Multiprocessing thread count"
msgstr "Többfolyamatú feldolgozás: szálak száma"

#: src/common/config.py:443
msgid "The number of threads to use when adding themes. Restart required. (min: 1)"
msgstr "A témák hozzáadásakor használandó szálak száma. Újraindítás szükséges. (min.: 1)"

#: src/common/config.py:450
msgid "YouTube Cookies"
msgstr "YouTube-sütik"

#: src/common/config.py:452
msgid "Optional: export youtube.com cookies with Get cookies.txt LOCALLY using its JSON format, then paste the entire JSON array here and save. Cookies contain your browser session; keep them private."
msgstr "Opcionális: exportáld a youtube.com cookie-jait a „Get cookies.txt” paranccsal HELYILEG JSON formátumban, majd illeszd be ide a teljes JSON-tömböt, és mentsd el. A cookie-k a böngésződ munkamenetét tartalmazzák; gondoskodj azok titkosságáról."

#: src/common/config.py:457
msgid "Cookie export instructions"
msgstr "A cookie-k exportálására vonatkozó utasítások"

