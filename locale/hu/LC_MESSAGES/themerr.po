#: src/common/config.py:136
msgid "Notifications"
msgstr "Értesítések"

#: src/common/config.py:137
msgid "Desktop notifications appear on the computer running Themerr. Docker and headless installations do not display them."
msgstr "Az asztali értesítések azon a számítógépen jelennek meg, amelyen a Themerr fut. A Docker- és a headless telepítések esetén ezek nem jelennek meg."

#: src/common/config.py:142 src/common/notifications.py:138
msgid "New release available"
msgstr "Új kiadás elérhető"

#: src/common/config.py:143
msgid "Notify when a newer Themerr release is available. Checks run once per hour."
msgstr "Értesíts, ha elérhető egy újabb Themerr-kiadás. Az ellenőrzés óránként egyszer történik."

#: src/common/config.py:148
msgid "Follow pre-releases"
msgstr "Kövesse az előzetes kiadásokat"

#: src/common/config.py:149
msgid "Include pre-releases in new release notifications."
msgstr "Az új kiadásokról szóló értesítésekbe vegyék fel az előzetes kiadásokat is."

#: src/common/config.py:154
msgid "Theme coverage increased"
msgstr "A témák lefedettsége nőtt"

#: src/common/config.py:155
msgid "Notify after a successful refresh when total theme coverage increases. Refreshes with no increase stay quiet."
msgstr "A sikeres frissítés után értesítsen, ha a téma teljes lefedettsége növekszik. Ha a frissítés során nem történik növekedés, ne küldjön értesítést."

#: src/common/config.py:162
msgid "Logging"
msgstr "Fakitermelés"

#: src/common/config.py:163
msgid "Logging settings."
msgstr "Naplózási beállítások."

#: src/common/config.py:167
msgid "Log directory"
msgstr "Naplókönyvtár"

#: src/common/config.py:169
msgid "The directory where to store the log files."
msgstr "Az a könyvtár, amelybe a naplófájlokat kell menteni."

#: src/common/config.py:176
msgid "Debug logging"
msgstr "Hibakeresési naplózás"

#: src/common/config.py:178
msgid "Enable debug logging."
msgstr "Engedélyezze a hibakeresési naplózást."

#: src/common/config.py:184
msgid "Network"
msgstr "Hálózat"

#: src/common/config.py:185
msgid "Network settings."
msgstr "Hálózati beállítások."

#: src/common/config.py:189
msgid "HTTP host address"
msgstr "HTTP-gazdagép-cím"

#: src/common/config.py:191
msgid "The HTTP address to bind to."
msgstr "A kapcsolni kívánt HTTP-cím."

#: src/common/config.py:200
msgid "HTTP port"
msgstr "HTTP-port"

#: src/common/config.py:202
msgid "Port to bind web server to. Note that ports below 1024 may require root."
msgstr "A webszerverhez rendelendő port. Figyelem: az 1024 alatti portok használatához root jogosultságra lehet szükség."

#: src/common/config.py:210
msgid "HTTP root"
msgstr "HTTP gyökérkönyvtár"

#: src/common/config.py:212
msgid "Todo: The base URL of the web server. Used for reverse proxies."
msgstr "Todo: A webszerver alap-URL-je. Fordított proxy-k esetén használatos."

#: src/common/config.py:217
msgid "SSL"
msgstr "SSL"

#: src/common/config.py:219
msgid "Run the web server with HTTPS. Disabling this can be a security risk, do so at your own risk."
msgstr "Indítsa el a webszervert HTTPS-en keresztül. Ennek letiltása biztonsági kockázatot jelenthet, ezért ezt saját felelősségére tegye."

#: src/common/config.py:225
msgid "Updater"
msgstr "Frissítő"

#: src/common/config.py:226
msgid "Updater settings."
msgstr "A frissítő beállításai."

#: src/common/config.py:230
msgid "Auto update"
msgstr "Automatikus frissítés"

#: src/common/config.py:238
msgid "Jellyfin"
msgstr "Jellyfin"

#: src/common/config.py:239
msgid "Jellyfin theme processing settings. Connections are managed on the Servers page."
msgstr "A Jellyfin témák feldolgozási beállításai. A kapcsolatok kezelése a „Szerverek” oldalon történik."

#: src/common/config.py:242 src/common/config.py:343
msgid "Movie support"
msgstr "Filmek támogatása"

#: src/common/config.py:243
msgid "Add themes to Jellyfin movies."
msgstr "Témák hozzáadása a Jellyfin-filmekhez."

#: src/common/config.py:246 src/common/config.py:349
msgid "Series support"
msgstr "Sorozat-támogatás"

#: src/common/config.py:247
msgid "Add themes to Jellyfin series."
msgstr "Témák hozzáadása a Jellyfin sorozatokhoz."

#: src/common/config.py:250 src/common/config.py:337 web/templates/home.html:31
msgid "Collections"
msgstr "Gyűjtemények"

#: src/common/config.py:251
msgid "Add themes inside Jellyfin’s collection directories. Media files can remain elsewhere."
msgstr "Helyezd el a témákat a Jellyfin gyűjteménykönyvtáraiba. A médiafájlok máshol is maradhatnak."

#: src/common/config.py:254
msgid "Overwrite user themes"
msgstr "Felhasználói témák felülírása"

#: src/common/config.py:255
msgid "Replace existing theme files, including themes created by the older Themerr-jellyfin plugin."
msgstr "Cserélje ki a meglévő témafájlokat, beleértve a régebbi Themerr-jellyfin bővítmény által létrehozott témákat is."

#: src/common/config.py:259
msgid "Back up replaced user themes"
msgstr "A kicserélt felhasználói témák biztonsági mentése"

#: src/common/config.py:260
msgid "Keep existing user themes in a backup folder when replacing them. Disable to permanently remove replaced themes."
msgstr "A meglévő felhasználói témákat a cseréjük során tárolja egy biztonsági másolat mappában. A beállítás kikapcsolásával véglegesen eltávolíthatja a kicserélt témákat."

#: src/common/config.py:264
msgid "Import older Themerr-jellyfin ownership"
msgstr "A Themerr-jellyfin korábbi tulajdonjogának átvétele"

#: src/common/config.py:265
msgid "Recognize themes recorded in the older plugin’s database only when their SHA-256 still matches. Changed files stay protected. The old database is left untouched."
msgstr "A régebbi bővítmény adatbázisában rögzített témákat csak akkor ismerje fel, ha azok SHA-256-értéke továbbra is egyezik. A módosított fájlok védelme megmarad. A régi adatbázis változatlan marad."

#: src/common/config.py:269
msgid "Ignore locked metadata"
msgstr "A zárolt metaadatok figyelmen kívül hagyása"

#: src/common/config.py:270
msgid "Allow Jellyfin theme updates for items with locked metadata."
msgstr "Engedélyezze a Jellyfin-téma frissítését a lezárt metaadatokkal rendelkező elemek esetében."

#: src/common/config.py:273
msgid "Update connector automatically"
msgstr "A csatlakozó automatikus frissítése"

#: src/common/config.py:274
msgid "Install the matching connector when Themerr starts or detects a version mismatch. Set the reachable Themerr address on the Servers page first."
msgstr "Telepítse a megfelelő csatlakozót, amikor a Themerr elindul, vagy verzióeltérést észlel. Először állítsa be a Themerr elérhető címét a „Szerverek” oldalon."

#: src/common/config.py:278
msgid "Restart Jellyfin automatically"
msgstr "A Jellyfin automatikus újraindítása"

#: src/common/config.py:279
msgid "Restart Jellyfin after installing or updating the connector. A pending restart is shown on the Servers page before it happens."
msgstr "A csatlakozó telepítése vagy frissítése után indítsa újra a Jellyfin programot. Az újraindítás előtt a „Kiszolgálók” oldalon megjelenik egy függőben lévő újraindítás."

#: src/common/config.py:283
msgid "Wait for playback to finish"
msgstr "Várja meg, amíg a lejátszás befejeződik"

#: src/common/config.py:284
msgid "Defer connector restarts until there are no playing or paused streams."
msgstr "A csatlakozó újraindítását addig halassza el, amíg nincs lejátszás alatt álló vagy szüneteltetett stream."

#: src/common/config.py:287
msgid "Remove the older Themerr-jellyfin plugin"
msgstr "Távolítsa el a régebbi Themerr-jellyfin bővítményt"

#: src/common/config.py:288
msgid "After installing the connector, uninstall the older Themerr plugin and remove only its dedicated repository. Existing theme files are kept."
msgstr "A csatlakozó telepítése után távolítsa el a régebbi Themerr bővítményt, és csak annak saját tárolóját törölje. A meglévő témafájlok megmaradnak."

#: src/common/config.py:292
msgid "Connector HTTP port"
msgstr "Csatlakozó HTTP-portja"

#: src/common/config.py:293
msgid "Serve only connector downloads over HTTP when Themerr uses a self-signed certificate. The admin UI stays on HTTPS. Use 0 to disable. Restart Themerr after changing this port."
msgstr "Csak akkor szolgáltasson csatlakozó-letöltéseket HTTP-n keresztül, ha a Themerr önaláírt tanúsítványt használ. Az adminisztrációs felület továbbra is HTTPS-en marad. A letiltáshoz állítsa be a 0 értéket. A port módosítása után indítsa újra a Themerr-t."

#: src/common/config.py:300
msgid "Plex"
msgstr "Plex"

#: src/common/config.py:301
msgid "Plex settings."
msgstr "A Plex beállításai."

#: src/common/config.py:305
msgid "Plex URL"
msgstr "Plex URL"

#: src/common/config.py:306
msgid "The URL to the Plex server."
msgstr "A Plex-kiszolgáló URL-címe."

