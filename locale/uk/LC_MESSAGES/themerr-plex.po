msgstr "Медична перевірка контейнерів та виходу"

#: src/themerr_plex.py:183
#, python-format
msgid "Do not open %(app_name)s in browser"
msgstr "Не відкривати %(app_name)s у браузері"

#: src/themerr_plex.py:186
#, python-format
msgid "Force %(app_name)s to run on a specified port, default=9494"
msgstr "Змусити %(app_name)s працювати на вказаному порті, за замовчуванням=9494"

#: src/themerr_plex.py:189
msgid "Turn off console logging"
msgstr "Вимкнути журналювання консолі"

#: src/themerr_plex.py:190
msgid "Print the version details and exit"
msgstr "Роздрукувати інформацію про версію та вийти"

#: web/js/api.js:9
msgid "Your session expired. Sign in to continue."
msgstr "Термін дійсності вашого сеансу завершився. Увійдіть, щоб продовжити."

#: web/js/api.js:25
msgid "Dismiss message"
msgstr "Відхилити повідомлення"

#: web/js/config.js:17 web/js/config.js:40
msgid "Unsaved changes"
msgstr "Незбережені зміни"

#: web/js/config.js:40 web/templates/config.html:36
msgid "All changes saved."
msgstr "Всі зміни збережено."

#: web/js/config.js:42
msgid "Settings saved. Network changes take effect after restarting Themerr."
msgstr "Параметри збережені. Мережа змінює ефект після перезапуску Themerr."

#: web/js/config.js:46
msgid "Unable to save changes."
msgstr "Не вдалося зберегти зміни."

#: web/js/config.js:54
msgid "Save your settings changes before changing your password."
msgstr "Збережіть налаштування перед зміною вашого пароля."

#: web/templates/activity.html:3
msgid "BEHIND THE MUSIC"
msgstr "ПІДКАЗАТИ МУЗИКУ"

#: web/templates/activity.html:3
msgid "See what Themerr is working on, and why an item might need your attention."
msgstr "Подивіться, на що працює Themerr, і чому елемент може потребувати вашої уваги."

#: web/templates/activity.html:3
msgid "Scan for themes"
msgstr "Сканувати на тему"

#: web/templates/activity.html:3 web/templates/navbar.html:6
msgid "Activity"
msgstr "Активність"

#: web/templates/activity.html:4
msgid "items waiting in the processing queue"
msgstr "елементи в черзі обробки"

#: web/templates/activity.html:4
msgid "Task history covers the current application session."
msgstr "Історія завдань охоплює поточну сесію програми."

#: web/templates/activity.html:5
msgid "Recent tasks"
msgstr "Нещодавні завдання"

#: web/templates/activity.html:5
msgid "Live"
msgstr "Наживо"

#: web/templates/activity.html:6
msgid "No tasks have run yet. Request a scan, or wait for the next scheduled refresh."
msgstr "Поки що немає завдань. Замовте сканування, або зачекайте наступного запланованого оновлення."

#: web/templates/activity.html:7 web/templates/home.html:14
#: web/templates/home.html:31 web/templates/servers.html:13
msgid "Needs attention"
msgstr "Потребує уваги"

#: web/templates/activity.html:8
msgid "No processing failures recorded. All quiet here."
msgstr "Обробка помилок не записана. Тут тихо."

#: web/templates/activity.html:8 web/templates/home.html:62
msgid "Plex ID"
msgstr "Plex ID"

#: web/templates/activity.html:8 web/templates/home.html:76
msgid "Outdated from ThemerrDB"
msgstr "Застаріла версія ThemerrDB"

#: web/templates/api_docs.html:7
msgid "Explore the API using your signed-in session."
msgstr "Ознайомтесь з API, використовуючи вашу сесію."

#: web/templates/api_docs.html:7 web/templates/api_docs.html:8
#: web/templates/navbar.html:13
msgid "API documentation"
msgstr "API документації"

#: web/templates/auth.html:7
msgid "THE SOUND OF YOUR LIBRARY"
msgstr "Норма ВАШИХ БІБЛІОТЕЙ"

#: web/templates/auth.html:8
msgid "Every story"
msgstr "Кожна історія"

#: web/templates/auth.html:8
msgid "has a soundtrack."
msgstr "має саундтрек."

#: web/templates/auth.html:9
msgid "Bring your Plex libraries to life. One calm workspace for your servers, your themes, and everything in between."
msgstr "Принесіть свої бібліотеки Plex в життя. Один спокійний робочий простір для ваших серверів, ваших тем і все між ними."

#: web/templates/auth.html:18
msgid "Your workspace, secured."
msgstr "Робітничий простір."

#: web/templates/auth.html:19
msgid "Open the one-time setup link printed in the application console to create your admin account."
msgstr "Відкрити одноразове посилання налаштування для створення облікового запису адміністратора."

#: web/templates/auth.html:20
msgid "The link is generated each time the application starts, until setup is complete."
msgstr "Після початку програми з'являється посилання до завершення встановлення."

#: web/templates/auth.html:22
msgid "GET STARTED"
msgstr "ПОЧАТОК"

#: web/templates/auth.html:22
msgid "WELCOME BACK"
msgstr "ЛАСКАВО"

#: web/templates/auth.html:23
msgid "Make it yours."
msgstr "Зробіть це твоє."

#: web/templates/auth.html:23
msgid "Sign in to Themerr."
msgstr "Увійти в Теми."

#: web/templates/auth.html:24
msgid "Create the administrator account for this installation."
msgstr "Створити обліковий запис адміністратора для цього встановлення."

#: web/templates/auth.html:24
msgid "Your libraries are waiting for their next soundtrack."
msgstr "Ваші бібліотеки чекають на їх наступний саундтрек."

#: web/templates/auth.html:28
msgid "Username"
msgstr "Ім'я користувача"

#: web/templates/auth.html:30
msgid "Password"
msgstr "Пароль"

#: web/templates/auth.html:33
msgid "Use at least 12 characters. A long, unique passphrase works well."
msgstr "Використовуйте принаймні 12 символів. Дуга, унікальна парольна фраза працює добре."

#: web/templates/auth.html:34
msgid "Confirm password"
msgstr "Підтвердити пароль"

#: web/templates/auth.html:37
msgid "Create workspace"
msgstr "Створити робоче середовище"

#: web/templates/auth.html:37
msgid "Sign in"
msgstr "Увійти"

#: web/templates/auth.html:39
msgid "Plex account linking happens inside your workspace."
msgstr "Приєднання до Plex рахунку відбувається у вашому робочому просторі."

#: web/templates/base.html:19
msgid "Skip to content"
msgstr "Перейти до вмісту"

#: web/templates/base.html:25
msgid "Toggle navigation"
msgstr "Переключити навігацію"

#: web/templates/base.html:26
msgid "Workspace"
msgstr "Робоча область"

#: web/templates/config.html:15
msgid "Browse directories for"
msgstr "Переглянути каталоги для"

#: web/templates/config.html:22
msgid "TUNE YOUR WORKSPACE"
msgstr "ЗАЛИШИТЕ ВАШУ СВІЙ ВІДРОДЖЕННЯ"

#: web/templates/config.html:22
msgid "Make Themerr work the way your library does."
msgstr "Змусити Themerr працювати так, як це робить ваша бібліотека."

#: web/templates/config.html:24
msgid "Settings sections"
msgstr "Налаштування розділів"

#: web/templates/config.html:24 web/templates/config.html:33
msgid "Security"
msgstr "Безпека"

#: web/templates/config.html:28
msgid "Server connections, data directories, and ignored libraries are managed on the Servers page."
msgstr "Серверне підключення, каталоги даних та проігноровані бібліотеки, керуються на сторінці серверів."

#: web/templates/config.html:28
msgid "Changes to network settings take effect after restarting Themerr."
msgstr "Зміни в мережі наберуть чинності після перезапуску теми."

