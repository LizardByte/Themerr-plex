msgid "First run complete"
msgstr "Перший запуск завершено"

#: src/common/config.py:106
msgid "Todo: Indicates if the user has completed the initial setup."
msgstr "Todo: Вказує, чи користувач завершив початкове налаштування."

#: src/common/config.py:113
msgid "General"
msgstr "Загальні налаштування"

#: src/common/config.py:114
msgid "General settings."
msgstr "Загальні налаштування."

#: src/common/config.py:118
msgid "Locale"
msgstr "Локалізація"

#: src/common/config.py:119
msgid "The localization setting to use."
msgstr "Налаштування локалізації для використання."

#: src/common/config.py:128
msgid "Launch Browser on Startup "
msgstr "Запустити браузер під час запуску програми "

#: src/common/config.py:134
msgid "Enable System Tray Icon"
msgstr "Увімкнути піктограму в системному лотку"

#: src/common/config.py:142
msgid "Logging"
msgstr "Заготівля лісу"

#: src/common/config.py:143
msgid "Logging settings."
msgstr "Налаштування ведення журналу."

#: src/common/config.py:147
msgid "Log directory"
msgstr "Папка логів"

#: src/common/config.py:149
msgid "The directory where to store the log files."
msgstr "Каталог, де зберігати файли журналу."

#: src/common/config.py:156
msgid "Debug logging"
msgstr "Ведення журналу налагодження"

#: src/common/config.py:158
msgid "Enable debug logging."
msgstr "Увімкнути журнал зневадження."

#: src/common/config.py:164
msgid "Network"
msgstr "Мережа"

#: src/common/config.py:165
msgid "Network settings."
msgstr "Налаштування мережі."

#: src/common/config.py:169
msgid "HTTP host address"
msgstr "HTTP-хост"

#: src/common/config.py:171
msgid "The HTTP address to bind to."
msgstr "HTTP адреса для прив'язки."

#: src/common/config.py:180
msgid "HTTP port"
msgstr "Порт HTTP"

#: src/common/config.py:182
msgid "Port to bind web server to. Note that ports below 1024 may require root."
msgstr "Порт для прив'язки до веб-сервера. Зауважте, що порти нижче 1024 можуть потребувати права суперкористувача."

#: src/common/config.py:190
msgid "HTTP root"
msgstr "Кореневий HTTP"

#: src/common/config.py:192
msgid "Todo: The base URL of the web server. Used for reverse proxies."
msgstr "До: Базова URL-адреса веб-сервера. Використовується для зворотних проксі."

#: src/common/config.py:197
msgid "SSL"
msgstr "SSL"

#: src/common/config.py:199
msgid "Run the web server with HTTPS. Disabling this can be a security risk, do so at your own risk."
msgstr "Запустіть веб-сервер з HTTPS. Вимкнення цього може бути ризиком безпеки, робіть це на власний ризик."

#: src/common/config.py:205
msgid "Updater"
msgstr "Оновлювач"

#: src/common/config.py:206
msgid "Updater settings."
msgstr "Налаштування оновлень."

#: src/common/config.py:210
msgid "Auto update"
msgstr "Автоматичне оновлення"

#: src/common/config.py:218
msgid "Plex"
msgstr "Плекс"

#: src/common/config.py:219
msgid "Plex settings."
msgstr "Налаштування Plex ."

#: src/common/config.py:223
msgid "Plex URL"
msgstr "Plex URL"

#: src/common/config.py:224
msgid "The URL to the Plex server."
msgstr "URL на сервері Plex."

#: src/common/config.py:233 web/templates/servers.html:20
msgid "Plex data directory"
msgstr "Каталог даних Plex"

#: src/common/config.py:234
msgid "https://support.plex.tv/articles/202915258-where-is-the-plex-media-server-data-directory-located/"
msgstr "https://support.plex.tv/articles/202915258-where-is-the-plea-server-data-directory-located/"

#: src/common/config.py:244
msgid "Themerr"
msgstr "Темерр"

#: src/common/config.py:245
msgid "Themerr settings."
msgstr "Налашт-ня теми."

#: src/common/config.py:249
msgid "Themerr Enabled"
msgstr "Тематика увімкнена"

#: src/common/config.py:250
msgid "When enabled, Themerr will attempt to update themes."
msgstr "Коли ввімкнено, Themerr спробує оновити теми."

#: src/common/config.py:255 web/templates/home.html:30
msgid "Collections"
msgstr "Колекції"

#: src/common/config.py:256
msgid "Add themes to collections."
msgstr "Додайте теми для колекції."

#: src/common/config.py:261
msgid "Movie support"
msgstr "Підтримка фільмів"

#: src/common/config.py:262
msgid "Add themes to movies using the Plex Movie agent."
msgstr "Додай теми у фільм, використовуючи Plex кіноагента."

#: src/common/config.py:267
msgid "Series support"
msgstr "Підтримка серії"

#: src/common/config.py:268
msgid "Add themes to series using the Plex Series agent."
msgstr "Додайте теми для серії, використовуючи агента Plex серії."

#: src/common/config.py:273
msgid "Overwrite Plex themes"
msgstr "Перезаписати Plex теми"

#: src/common/config.py:274
msgid "When enabled, Themerr will overwrite themes provided by Plex."
msgstr "Коли ввімкнено, Themerr буде перезаписувати теми, надані Plex."

#: src/common/config.py:279
msgid "Prefer MP4A AAC Codec"
msgstr "Перевага MP4A Codec"

#: src/common/config.py:280
msgid "This can improve theme compatibility with Apple devices."
msgstr "Це може покращити сумісність теми за допомогою пристроїв Apple."

#: src/common/config.py:285
msgid "Remove unused themes"
msgstr "Видалити невикористані теми"

#: src/common/config.py:286
msgid "Frees up space in your Plex metadata directory. This option requires that the \"Plex data directory\" path is set"
msgstr "Звільняє простір у вашій теці даних Plex. Ця опція вимагає, щоб задано шлях до каталогу даних Plex"

#: src/common/config.py:292
msgid "Remove unused art"
msgstr "Видалити невикористані твори"

#: src/common/config.py:293 src/common/config.py:301
msgid "Applies to collection. Frees up space in your Plex metadata directory. This option requires that the \"Plex data directory\" path is set"
msgstr "Застосовується до колекції. Звільняє простір у вашій папці метаданих Plex. Цей параметр вимагає, щоб встановлено шлях до каталогу \"Plex data directory\""

#: src/common/config.py:300
msgid "Remove unused posters"
msgstr "Вилучити невикористані плакати"

#: src/common/config.py:308
msgid "Collection metadata"
msgstr "Метадані колекції"

#: src/common/config.py:309
msgid "Update collection metadata (poster, art, and summary) during scheduled update."
msgstr "Оновлення метаданих колекції (постер, мистецтво і резюме) під час запланованих оновлень."

#: src/common/config.py:314
msgid "Ignore locked fields."
msgstr "Ігнорувати заблоковані поля."

#: src/common/config.py:315
msgid "If you used Themerr-plex v2024.813.13709 or lower, you may need to enable this to update items."
msgstr "Якщо ви використовували Themerr-plex v2024.813.13709 або нижче, вам може знадобитися увімкнути це для оновлення елементів."

#: src/common/config.py:321 web/templates/servers.html:23
msgid "Ignored library IDs"
msgstr "Ігноровані ID бібліотеки"

#: src/common/config.py:322
msgid "Comma-separated library IDs to exclude from scheduled updates. IDs appear on Home."
msgstr "ID бібліотеки, розділених комами, для виключення запланованих оновлень. ID відображаються на головній сторінці."

#: src/common/config.py:328
msgid "Update themes interval"
msgstr "Оновити інтервал тем"

#: src/common/config.py:329
msgid "Interval for automatic update task, in minutes (min: 15)."
msgstr "Інтервал автоматичного оновлення, у хвилинах (хв: 15)."

#: src/common/config.py:336
msgid "Update database cache interval"
msgstr "Оновлення інтервалу кешу даних"

#: src/common/config.py:337
msgid "Interval for database cache update task, in minutes (min: 15)."
msgstr "Інтервал перевірки кешу бази данних, через хвилину (хв: 15)."

#: src/common/config.py:344
msgid "PlexAPI timeout"
msgstr "Тривалість часу очікування PlexAPI"

#: src/common/config.py:345
msgid "Increase this slightly if you experience timeouts when adding themes. (min: 1)"
msgstr "Збільшіть це трохи, якщо у вас виникли тайм-аути при додаванні тем. (хв: 1)"

#: src/common/config.py:352
msgid "Theme upload retries"
msgstr "Спроби завантаження теми знову"

#: src/common/config.py:353
msgid "If uploading themes fail, retry this many times. (min: 0)"
msgstr "Якщо ви не можете завантажити теми, повторити це багато разів. (хв: 0)"

#: src/common/config.py:360
msgid "Multiprocessing thread count"
msgstr "Багатопроцесорна кількість потоків"

#: src/common/config.py:361
msgid "The number of threads to use when adding themes. Restart required. (min: 1)"
msgstr "Кількість потоків для використання при додаванні тем. Необхідно перезапустити тему (хв.: 1)"

#: src/common/config.py:368
msgid "YouTube Cookies"
msgstr "YouTube куки"

#: src/common/config.py:370
msgid "Optional: export youtube.com cookies with Get cookies.txt LOCALLY using its JSON format, then paste the entire JSON array here and save. Cookies contain your browser session; keep them private."
msgstr "Додатково: експортувати файли youtube.com за допомогою отримання cookies.txt LOCALLY з використанням його формату JSON, а потім вставте тут весь масив JSON і збережіть. Кукі містять ваш сеанс браузера; тримайте їх приватними."

#: src/common/config.py:375
msgid "Cookie export instructions"
msgstr "Інструкції для експорту файлів cookie"

