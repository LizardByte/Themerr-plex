msgid "The HTTP address to bind to."
msgstr "L'indirizzo HTTP a cui collegarsi."

#: src/common/config.py:201
msgid "HTTP port"
msgstr "Porta HTTP"

#: src/common/config.py:203
msgid "Port to bind web server to. Note that ports below 1024 may require root."
msgstr "Porta per collegare il server web. Notare che le porte inferiori a 1024 potrebbero richiedere la root."

#: src/common/config.py:211
msgid "HTTP root"
msgstr "Radice HTTP"

#: src/common/config.py:213
msgid "Todo: The base URL of the web server. Used for reverse proxies."
msgstr "Todo: L'URL di base del server web. Usato per proxy inversi."

#: src/common/config.py:218
msgid "SSL"
msgstr "SSL"

#: src/common/config.py:220
msgid "Run the web server with HTTPS. Disabling this can be a security risk, do so at your own risk."
msgstr "Eseguire il server web con HTTPS. Disabilitarlo può essere un rischio per la sicurezza, farlo a proprio rischio."

#: src/common/config.py:226
msgid "Updater"
msgstr "Aggiornatore"

#: src/common/config.py:227
msgid "Updater settings."
msgstr "Impostazioni aggiornatore."

#: src/common/config.py:231
msgid "Auto update"
msgstr "Aggiornamento automatico"

#: src/common/config.py:239
msgid "Jellyfin"
msgstr "Jellyfin"

#: src/common/config.py:240
msgid "Jellyfin theme processing settings. Connections are managed on the Servers page."
msgstr "Impostazioni di elaborazione del tema Jellyfin. Le connessioni sono gestite nella pagina Server."

#: src/common/config.py:243 src/common/config.py:344
msgid "Movie support"
msgstr "Supporto film"

#: src/common/config.py:244
msgid "Add themes to Jellyfin movies."
msgstr "Aggiungi temi ai film di Jellyfin."

#: src/common/config.py:247 src/common/config.py:350
msgid "Series support"
msgstr "Supporto serie"

#: src/common/config.py:248
msgid "Add themes to Jellyfin series."
msgstr "Aggiungi temi alla serie Jellyfin."

#: src/common/config.py:251 src/common/config.py:338 web/templates/home.html:31
msgid "Collections"
msgstr "Raccolte"

#: src/common/config.py:252
msgid "Add themes inside Jellyfin’s collection directories. Media files can remain elsewhere."
msgstr "Aggiungi temi nelle directory della collezione di Jellyfin. I file multimediali possono rimanere altrove."

#: src/common/config.py:255
msgid "Overwrite user themes"
msgstr "Sovrascrivi temi utente"

#: src/common/config.py:256
msgid "Replace existing theme files, including themes created by the older Themerr-jellyfin plugin."
msgstr "Sostituire i file di tema esistenti, inclusi i temi creati dal vecchio plugin Themerr-jellyfin."

#: src/common/config.py:260
msgid "Back up replaced user themes"
msgstr "Backup dei temi utente sostituiti"

#: src/common/config.py:261
msgid "Keep existing user themes in a backup folder when replacing them. Disable to permanently remove replaced themes."
msgstr "Mantieni i temi utente esistenti in una cartella di backup quando li sostituisce. Disabilita per rimuovere definitivamente i temi sostituiti."

#: src/common/config.py:265
msgid "Import older Themerr-jellyfin ownership"
msgstr "Importa proprietà più vecchie di Themerr-jellyfin"

#: src/common/config.py:266
msgid "Recognize themes recorded in the older plugin’s database only when their SHA-256 still matches. Changed files stay protected. The old database is left untouched."
msgstr "Riconosci i temi registrati nel database del plugin più vecchio solo quando il loro SHA-256 corrisponde. I file modificati rimangono protetti. Il vecchio database è lasciato intatto."

#: src/common/config.py:270
msgid "Ignore locked metadata"
msgstr "Ignora i metadati bloccati"

#: src/common/config.py:271
msgid "Allow Jellyfin theme updates for items with locked metadata."
msgstr "Consenti gli aggiornamenti del tema Jellyfin per gli elementi con metadati bloccati."

#: src/common/config.py:274
msgid "Update connector automatically"
msgstr "Aggiorna il connettore automaticamente"

#: src/common/config.py:275
msgid "Install the matching connector when Themerr starts or detects a version mismatch. Set the reachable Themerr address on the Servers page first."
msgstr "Installare il connettore corrispondente quando Themerr avvia o rileva una versione non corrispondente. Impostare prima l'indirizzo Themerr raggiungibile sulla pagina Server ."

#: src/common/config.py:279
msgid "Restart Jellyfin automatically"
msgstr "Riavvia Jellyfin automaticamente"

#: src/common/config.py:280
msgid "Restart Jellyfin after installing or updating the connector. A pending restart is shown on the Servers page before it happens."
msgstr "Riavviare Jellyfin dopo aver installato o aggiornato il connettore. Un riavvio in sospeso viene mostrato nella pagina Server prima che accada ."

#: src/common/config.py:284
msgid "Wait for playback to finish"
msgstr "Attendi che la riproduzione finisca"

#: src/common/config.py:285
msgid "Defer connector restarts until there are no playing or paused streams."
msgstr "Rinvia il riavvio del connettore fino a quando non ci sono flussi in riproduzione o in pausa."

#: src/common/config.py:288
msgid "Remove the older Themerr-jellyfin plugin"
msgstr "Rimuovere il plugin Themerr-jellyfin più vecchio"

#: src/common/config.py:289
msgid "After installing the connector, uninstall the older Themerr plugin and remove only its dedicated repository. Existing theme files are kept."
msgstr "Dopo aver installato il connettore, disinstallare il plugin Themerr più vecchio e rimuovere solo il suo repository dedicato. I file di tema esistenti vengono mantenuti."

#: src/common/config.py:293
msgid "Connector HTTP port"
msgstr "Porta connettore HTTP"

#: src/common/config.py:294
msgid "Serve only connector downloads over HTTP when Themerr uses a self-signed certificate. The admin UI stays on HTTPS. Use 0 to disable. Restart Themerr after changing this port."
msgstr "Servire solo i download del connettore su HTTP quando Themerr utilizza un certificato autofirmato. L'interfaccia utente di amministrazione rimane su HTTPS. Usa 0 per disabilitare. Riavvia Themerr dopo aver cambiato questa porta."

