msgid "SSL"
msgstr "SSL"

#: src/common/config.py:225
msgid "Run the web server with HTTPS. Disabling this can be a security risk, do so at your own risk."
msgstr "Spusťte webový server s HTTPS. Zakázáním této funkce může být bezpečnostní riziko, udělejte tak na vlastní riziko."

#: src/common/config.py:231
msgid "Updater"
msgstr "Aktualizátor"

