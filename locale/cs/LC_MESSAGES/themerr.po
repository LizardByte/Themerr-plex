msgstr "Datový adresář Plexu"

#: src/common/config.py:260
msgid "https://support.plex.tv/articles/202915258-where-is-the-plex-media-server-data-directory-located/"
msgstr "https://support.plex.tv/articles/202915258-where-is-the-plex-media-server-data-directory-located/"

#: src/common/config.py:270
msgid "Themerr"
msgstr "Themerr"

#: src/common/config.py:271
msgid "Themerr settings."
msgstr "Nastavení Themerr."

#: src/common/config.py:275
msgid "Themerr Enabled"
msgstr "Themerr povolen"

#: src/common/config.py:276
msgid "When enabled, Themerr will attempt to update themes."
msgstr "Pokud je povoleno, Themerr se pokusí aktualizovat motivy."

#: src/common/config.py:281 web/templates/home.html:30
msgid "Collections"
msgstr "Sbírky"

#: src/common/config.py:282
msgid "Add themes to collections."
msgstr "Přidat témata do kolekcí."

#: src/common/config.py:287
msgid "Movie support"
msgstr "Podpora filmů"

#: src/common/config.py:288
msgid "Add themes to movies using the Plex Movie agent."
msgstr "Přidejte motivy do filmů pomocí Plex Movie agenta."

#: src/common/config.py:293
msgid "Series support"
msgstr "Podpora série"

#: src/common/config.py:294
msgid "Add themes to series using the Plex Series agent."
msgstr "Přidejte témata do série pomocí Plex Series agenta."

#: src/common/config.py:299
msgid "Overwrite Plex themes"
msgstr "Přepsat vzhled Plexu"

#: src/common/config.py:300
msgid "When enabled, Themerr will overwrite themes provided by Plex."
msgstr "Pokud je povoleno, Themerr přepíše motivy poskytované Plexem."

#: src/common/config.py:305
msgid "Prefer MP4A AAC Codec"
msgstr "Preferovat kodek MP4A AAC"

#: src/common/config.py:306
msgid "This can improve theme compatibility with Apple devices."
msgstr "Toto může zlepšit kompatibilitu motivu se zařízeními Apple."

#: src/common/config.py:311
msgid "Remove unused themes"
msgstr "Odstranit nepoužité motivy"

#: src/common/config.py:312
msgid "Frees up space in your Plex metadata directory. This option requires that the \"Plex data directory\" path is set"
msgstr "Uvolní místo ve vašem adresáři metadat Plex. Tato volba vyžaduje, aby byla nastavena cesta k \"datovému adresáři Plex\"."

#: src/common/config.py:318
msgid "Remove unused art"
msgstr "Odstranit nepoužité umění"

#: src/common/config.py:319 src/common/config.py:327
msgid "Applies to collection. Frees up space in your Plex metadata directory. This option requires that the \"Plex data directory\" path is set"
msgstr "Aplikuje se na kolekci. Uvolňuje místo ve vašem adresáři metadat Plex. Tato volba vyžaduje, aby byla nastavena cesta k \"datovému adresáři Plex\"."

#: src/common/config.py:326
msgid "Remove unused posters"
msgstr "Odstranit nepoužité plakáty"

#: src/common/config.py:334
msgid "Collection metadata"
msgstr "Metadata kolekce"

#: src/common/config.py:335
msgid "Update collection metadata (poster, art, and summary) during scheduled update."
msgstr "Aktualizovat metadata kolekce (plakát, umění a shrnutí) během plánované aktualizace."

#: src/common/config.py:340
msgid "Ignore locked fields."
msgstr "Ignorovat uzamčená pole."

#: src/common/config.py:341
msgid "If you used Themerr v2024.813.13709 or lower, you may need to enable this to update items."
msgstr "Pokud používáte Themerr v2024.813.13709 nebo nižší, možná budete muset povolit aktualizaci položek."

#: src/common/config.py:347
msgid "Ignored library IDs"
msgstr "Ignorované ID knihovny"

#: src/common/config.py:348
msgid "Comma-separated library IDs to exclude from scheduled updates. IDs appear on Home."
msgstr "ID knihovny oddělené čárkami pro vyloučení z plánovaných aktualizací. ID se zobrazí na domovské obrazovce."

#: src/common/config.py:354
msgid "Update themes interval"
msgstr "Interval aktualizace motivů"

#: src/common/config.py:355
msgid "Interval for automatic update task, in minutes (min: 15)."
msgstr "Interval pro automatickou aktualizaci (min: 15)."

#: src/common/config.py:362
msgid "Update database cache interval"
msgstr "Interval aktualizace databázové mezipaměti"

#: src/common/config.py:363
msgid "Interval for database cache update task, in minutes (min: 15)."
msgstr "Interval pro úkol aktualizace databáze mezipaměti v minutách (min: 15)."

#: src/common/config.py:370
msgid "PlexAPI timeout"
msgstr "Časový limit PlexAPI"

#: src/common/config.py:371
msgid "Increase this slightly if you experience timeouts when adding themes. (min: 1)"
msgstr "Zvyšte to lehce pokud máte časový limit při přidávání motivů. (min: 1)"

#: src/common/config.py:378
msgid "Theme upload retries"
msgstr "Opakování nahrávání motivů"

#: src/common/config.py:379
msgid "If uploading themes fail, retry this many times. (min: 0)"
msgstr "Pokud nahrávání motivů selhalo, opakujte tuto akci mnohokrát. (min: 0)"

#: src/common/config.py:386
msgid "Multiprocessing thread count"
msgstr "Víceúčelový počet vláken"

#: src/common/config.py:387
msgid "The number of threads to use when adding themes. Restart required. (min: 1)"
msgstr "Počet vláken, která mají být použita při přidávání motivů. Vyžadován restart (min: 1)"

#: src/common/config.py:394
msgid "YouTube Cookies"
msgstr "YouTube Cookies"

#: src/common/config.py:396
msgid "Optional: export youtube.com cookies with Get cookies.txt LOCALLY using its JSON format, then paste the entire JSON array here and save. Cookies contain your browser session; keep them private."
msgstr "Volitelné: exportujte cookies youtube.com pomocí Get cookies.txt LOCALLY ve formátu JSON a vložte do něj celé JSON pole a uložte. Soubory cookie obsahují relaci prohlížeče; uchovávají je soukromé."

#: src/common/config.py:401
msgid "Cookie export instructions"
msgstr "Pokyny pro export cookie"

