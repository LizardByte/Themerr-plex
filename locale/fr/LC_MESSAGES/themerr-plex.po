msgid "Add themes to movies using the Plex Movie agent."
msgstr "Ajoutez des thèmes aux films en utilisant l'agent de film de Plex."

#: src/common/config.py:267
msgid "Series support"
msgstr "Prise en charge des séries"

#: src/common/config.py:268
msgid "Add themes to series using the Plex Series agent."
msgstr "Ajoutez des thèmes à la série en utilisant l'agent de la Série Plex ."

#: src/common/config.py:273
msgid "Overwrite Plex themes"
msgstr "Écraser les thèmes Plex"

#: src/common/config.py:274
msgid "When enabled, Themerr will overwrite themes provided by Plex."
msgstr "Lorsque cette option est activée, Themerr écrasera les thèmes fournis par Plex."

#: src/common/config.py:279
msgid "Prefer MP4A AAC Codec"
msgstr "Préférer le Codec AAC MP4A"

#: src/common/config.py:280
msgid "This can improve theme compatibility with Apple devices."
msgstr "Cela peut améliorer la compatibilité du thème avec les appareils Apple."

#: src/common/config.py:285
msgid "Remove unused themes"
msgstr "Supprimer les thèmes inutilisés"

#: src/common/config.py:286
msgid "Frees up space in your Plex metadata directory. This option requires that the \"Plex data directory\" path is set"
msgstr "Libère de l'espace dans le répertoire de vos métadonnées de Plex. Cette option nécessite que le chemin \"Répertoire de données de Plex\" soit défini"

#: src/common/config.py:292
msgid "Remove unused art"
msgstr "Supprimer les œuvres inutilisées"

#: src/common/config.py:293 src/common/config.py:301
msgid "Applies to collection. Frees up space in your Plex metadata directory. This option requires that the \"Plex data directory\" path is set"
msgstr "S'applique à la collection. Libère de l'espace dans votre répertoire de métadonnées de Plex. Cette option nécessite que le chemin \"Répertoire de données de Plex\" soit défini"

#: src/common/config.py:300
msgid "Remove unused posters"
msgstr "Supprimer les affiches inutilisées"

#: src/common/config.py:308
msgid "Collection metadata"
msgstr "Métadonnées de la collection"

#: src/common/config.py:309
msgid "Update collection metadata (poster, art, and summary) during scheduled update."
msgstr "Mettre à jour les métadonnées de la collection (affiche, art et résumé) lors de la mise à jour programmée."

#: src/common/config.py:314
msgid "Ignore locked fields."
msgstr "Ignorer les champs verrouillés."

#: src/common/config.py:315
msgid "If you used Themerr-plex v2024.813.13709 or lower, you may need to enable this to update items."
msgstr "Si vous avez utilisé Themerr-plex v2024.813.13709 ou inférieur, vous devrez peut-être l'activer pour mettre à jour les éléments."

#: src/common/config.py:321 web/templates/servers.html:23
msgid "Ignored library IDs"
msgstr "ID de la bibliothèque ignoré"

#: src/common/config.py:322
msgid "Comma-separated library IDs to exclude from scheduled updates. IDs appear on Home."
msgstr "IDs de librairie séparés par des virgules pour exclure des mises à jour planifiées. Les identifiants apparaissent sur la page d'accueil."

#: src/common/config.py:328
msgid "Update themes interval"
msgstr "Mettre à jour l'intervalle des thèmes"

#: src/common/config.py:329
msgid "Interval for automatic update task, in minutes (min: 15)."
msgstr "Intervalle pour la tâche de mise à jour automatique, en minutes (min. 15)."

#: src/common/config.py:336
msgid "Update database cache interval"
msgstr "Mettre à jour l'intervalle de cache de la base de données"

#: src/common/config.py:337
msgid "Interval for database cache update task, in minutes (min: 15)."
msgstr "Intervalle pour la tâche de mise à jour du cache de la base de données, en minutes (min. 15)."

#: src/common/config.py:344
msgid "PlexAPI timeout"
msgstr "Délai d'attente PlexAPI"

#: src/common/config.py:345
msgid "Increase this slightly if you experience timeouts when adding themes. (min: 1)"
msgstr "Augmentez légèrement si vous rencontrez des délais d'attente lors de l'ajout de thèmes. (min : 1)"

#: src/common/config.py:352
msgid "Theme upload retries"
msgstr "Tentatives de téléchargement du thème"

#: src/common/config.py:353
msgid "If uploading themes fail, retry this many times. (min: 0)"
msgstr "Si le téléchargement de thèmes échoue, réessayez plusieurs fois. (min : 0)"

#: src/common/config.py:360
msgid "Multiprocessing thread count"
msgstr "Nombre de fils multitraitement"

#: src/common/config.py:361
msgid "The number of threads to use when adding themes. Restart required. (min: 1)"
msgstr "Le nombre de threads à utiliser lors de l'ajout de thèmes. Redémarrage requis. (min: 1)"

#: src/common/config.py:368
msgid "YouTube Cookies"
msgstr "Cookies YouTube"

#: src/common/config.py:370
msgid "Optional: export youtube.com cookies with Get cookies.txt LOCALLY using its JSON format, then paste the entire JSON array here and save. Cookies contain your browser session; keep them private."
msgstr "Optionnel: exporter les cookies youtube.com avec Get cookies.txt LOCALLY en utilisant son format JSON, puis coller le tableau entier JSON ici et sauvegarder. Les cookies contiennent votre session de navigateur; gardez les confidentiels."

#: src/common/config.py:375
msgid "Cookie export instructions"
msgstr "Instructions d'exportation de cookies"

