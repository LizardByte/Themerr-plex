msgstr "SSL"

#: src/common/config.py:220
msgid "Run the web server with HTTPS. Disabling this can be a security risk, do so at your own risk."
msgstr "Ejecutar el servidor web con HTTPS. Deshabilitar esto puede ser un riesgo de seguridad, hacerlo bajo su propio riesgo."

#: src/common/config.py:226
msgid "Updater"
msgstr "Actualización"

#: src/common/config.py:227
msgid "Updater settings."
msgstr "Ajustes del actualizador."

#: src/common/config.py:231
msgid "Auto update"
msgstr "Actualización automática"

#: src/common/config.py:239
msgid "Jellyfin"
msgstr "Jellyfin"

#: src/common/config.py:240
msgid "Jellyfin theme processing settings. Connections are managed on the Servers page."
msgstr "Configuración de procesamiento de temas Jellyfin . Las conexiones se gestionan en la página de servidores."

#: src/common/config.py:243 src/common/config.py:344
msgid "Movie support"
msgstr "Soporte de película"

#: src/common/config.py:244
msgid "Add themes to Jellyfin movies."
msgstr "Añadir temas a las películas de Jellyfin."

#: src/common/config.py:247 src/common/config.py:350
msgid "Series support"
msgstr "Soporte de la serie"

#: src/common/config.py:248
msgid "Add themes to Jellyfin series."
msgstr "Añadir temas a la serie Jellyfin."

#: src/common/config.py:251 src/common/config.py:338 web/templates/home.html:31
msgid "Collections"
msgstr "Colecciones"

#: src/common/config.py:252
msgid "Add themes inside Jellyfin’s collection directories. Media files can remain elsewhere."
msgstr "Añade temas dentro de los directorios de la colección de Jellyfin. Los archivos multimedia pueden permanecer en otro lugar."

#: src/common/config.py:255
msgid "Overwrite user themes"
msgstr "Sobrescribir temas de usuario"

#: src/common/config.py:256
msgid "Replace existing theme files, including themes created by the older Themerr-jellyfin plugin."
msgstr "Reemplace los archivos de temas existentes, incluyendo los temas creados por el complemento de Themerr-jellyfin antiguo."

#: src/common/config.py:260
msgid "Back up replaced user themes"
msgstr "Respaldar temas de usuario reemplazados"

#: src/common/config.py:261
msgid "Keep existing user themes in a backup folder when replacing them. Disable to permanently remove replaced themes."
msgstr "Mantener los temas de usuario existentes en una carpeta de copia de seguridad al reemplazarlos. Desactivar para eliminar permanentemente los temas reemplazados."

#: src/common/config.py:265
msgid "Import older Themerr-jellyfin ownership"
msgstr "Importar posesión de jaletas temáticas antiguas"

#: src/common/config.py:266
msgid "Recognize themes recorded in the older plugin’s database only when their SHA-256 still matches. Changed files stay protected. The old database is left untouched."
msgstr "Reconocer temas grabados en la base de datos del plugin anterior sólo cuando su SHA-256 todavía coincide. Los archivos cambiados permanecen protegidos. La base de datos antigua no se ha tocado."

#: src/common/config.py:270
msgid "Ignore locked metadata"
msgstr "Ignorar metadatos bloqueados"

#: src/common/config.py:271
msgid "Allow Jellyfin theme updates for items with locked metadata."
msgstr "Permitir actualizaciones del tema Jellyfin para elementos con metadatos bloqueados."

#: src/common/config.py:274
msgid "Update connector automatically"
msgstr "Actualizar el conector automáticamente"

#: src/common/config.py:275
msgid "Install the matching connector when Themerr starts or detects a version mismatch. Set the reachable Themerr address on the Servers page first."
msgstr "Instalar el conector coincidente cuando Themerr arranca o detecta un fallo de versión. Establecer la dirección Themerr accesible en la página de servidores primero."

#: src/common/config.py:279
msgid "Restart Jellyfin automatically"
msgstr "Reiniciar Jellyfin automáticamente"

#: src/common/config.py:280
msgid "Restart Jellyfin after installing or updating the connector. A pending restart is shown on the Servers page before it happens."
msgstr "Reinicie Jellyfin después de instalar o actualizar el conector. Se mostrará un reinicio pendiente en la página de servidores antes de que suceda."

#: src/common/config.py:284
msgid "Wait for playback to finish"
msgstr "Espere a que termine la reproducción"

#: src/common/config.py:285
msgid "Defer connector restarts until there are no playing or paused streams."
msgstr "Aplazar el conector se reinicia hasta que no haya flujos en pausa o reproducidos."

#: src/common/config.py:288
msgid "Remove the older Themerr-jellyfin plugin"
msgstr "Eliminar el plugin Themerr-jellyfin anterior"

#: src/common/config.py:289
msgid "After installing the connector, uninstall the older Themerr plugin and remove only its dedicated repository. Existing theme files are kept."
msgstr "Después de instalar el conector, desinstale el antiguo plugin Themerr y elimine sólo su repositorio dedicado. Los archivos de tema existentes están asegurados."

#: src/common/config.py:293
msgid "Connector HTTP port"
msgstr "Puerto HTTP del conector"

#: src/common/config.py:294
msgid "Serve only connector downloads over HTTP when Themerr uses a self-signed certificate. The admin UI stays on HTTPS. Use 0 to disable. Restart Themerr after changing this port."
msgstr "Servir sólo descargas de conector a través de HTTP cuando Themerr utiliza un certificado autofirmado. La interfaz de administración permanece en HTTPS. Use 0 para desactivar. Reinicie Themerr después de cambiar este puerto."

