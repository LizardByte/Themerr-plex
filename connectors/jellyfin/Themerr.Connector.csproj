<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../src/jellyfin/compatibility.props" />
  <PropertyGroup>
    <TargetFramework>$(ConnectorFramework)</TargetFramework>
    <ConnectorBuild Condition="'$(ConnectorBuild)' == ''">development</ConnectorBuild>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>Themerr.Connector</AssemblyName>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">0.0.0.0</AssemblyVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="bin/**/*.cs;obj/**/*.cs" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)" PrivateAssets="all" />
    <!-- Match the EF Core/SQLite versions used by these Jellyfin SDKs. Runtime DLLs are supplied by Jellyfin. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(ConnectorEfCoreVersion)" PrivateAssets="all" />
    <AssemblyMetadata Include="ThemerrBuild" Value="$(ConnectorBuild)" />
    <AssemblyMetadata Include="JellyfinAbi" Value="$(JellyfinMinimumVersion)" />
  </ItemGroup>
</Project>
