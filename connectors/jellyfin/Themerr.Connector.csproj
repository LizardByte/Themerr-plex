<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ConnectorFramework Condition="'$(ConnectorFramework)' == ''">net10.0</ConnectorFramework>
    <TargetFramework>$(ConnectorFramework)</TargetFramework>
    <JellyfinVersion Condition="'$(JellyfinVersion)' == ''">12.2.0</JellyfinVersion>
    <ConnectorBuild Condition="'$(ConnectorBuild)' == ''">development</ConnectorBuild>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>Themerr.Connector</AssemblyName>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">0.0.0.0</AssemblyVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="bin/**/*.cs;obj/**/*.cs" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)" PrivateAssets="all" />
    <!-- Match the EF Core/SQLite versions used by these Jellyfin SDKs. Runtime DLLs are supplied by Jellyfin. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.10" Condition="'$(ConnectorFramework)' == 'net9.0'" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" Condition="'$(ConnectorFramework)' == 'net10.0'" PrivateAssets="all" />
    <AssemblyMetadata Include="ThemerrBuild" Value="$(ConnectorBuild)" />
    <AssemblyMetadata Include="JellyfinAbi" Value="$(JellyfinVersion)" />
  </ItemGroup>
</Project>
